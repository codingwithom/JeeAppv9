      "content": "<p>Prolonged heating is avoided during the preparation of ferrous ammonium sulphate to :</p>",
      "options": [
        {
          "identifier": "A",
          "content": "prevent hydrolysis"
        },
        {
          "identifier": "B",
          "content": "prevent breaking"
        },
        {
          "identifier": "C",
          "content": "prevent oxidation"
        },
        {
          "identifier": "D",
          "content": "prevent reduction"
        }
      ],
      "correct_options": [
        "C"
      ],
