      "content": "Which one of the following 0.06 M aqueous solutions has lowest freezing point?",
      "options": [
        {
          "identifier": "A",
          "content": "Al<sub>2</sub>(SO<sub>4</sub>)<sub>3</sub>"
        },
        {
