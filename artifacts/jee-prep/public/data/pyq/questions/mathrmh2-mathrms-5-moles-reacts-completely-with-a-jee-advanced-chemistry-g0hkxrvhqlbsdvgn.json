e=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"1D432\" xlink:href=\"#MJX-TEX-B-1D432\"></use></g></g></g></g></svg></mjx-container>. The value of <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.566ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"7.272ex\" height=\"2.262ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -750 3214.4 1000\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"mo\"><use data-c=\"28\" xlink:href=\"#MJX-TEX-N-28\"></use></g><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\" transform=\"translate(389,0)\"><g data-mml-node=\"mi\"><use data-c=\"1D431\" xlink:href=\"#MJX-TEX-B-1D431\"></use></g></g><g data-mml-node=\"mo\" transform=\"translate(1218.2,0)\"><use data-c=\"2B\" xlink:href=\"#MJX-TEX-N-2B\"></use></g><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\" transform=\"translate(2218.4,0)\"><g data-mml-node=\"mi\"><use data-c=\"1D432\" xlink:href=\"#MJX-TEX-B-1D432\"></use></g></g><g data-mml-node=\"mo\" transform=\"translate(2825.4,0)\"><use data-c=\"29\" xlink:href=\"#MJX-TEX-N-29\"></use></g></g></g></svg></mjx-container> is ________.",
      "options": [],
