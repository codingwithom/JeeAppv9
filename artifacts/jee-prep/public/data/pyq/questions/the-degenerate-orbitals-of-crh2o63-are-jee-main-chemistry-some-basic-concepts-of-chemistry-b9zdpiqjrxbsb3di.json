        {
          "identifier": "C",
          "content": "d<sub>yz</sub> and d<sub>z<sup>2</sup></sub>"
        },
        {
          "identifier": "D",
          "content": "d<sub>x<sup>2</sup> - y<sup>2</sup></sub> and d<sub>xy</sub>"
