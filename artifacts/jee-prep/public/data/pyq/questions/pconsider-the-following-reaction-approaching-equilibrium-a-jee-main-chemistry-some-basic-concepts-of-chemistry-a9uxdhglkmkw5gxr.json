1.805ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -716 6944.4 798\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"41\" xlink:href=\"#MJX-TEX-N-41\"></use></g><g data-mml-node=\"mo\" transform=\"translate(972.2,0)\"><use data-c=\"2B\" xlink:href=\"#MJX-TEX-N-2B\"></use></g><g data-mml-node=\"mi\" transform=\"translate(1972.4,0)\"><use data-c=\"42\" xlink:href=\"#MJX-TEX-N-42\"></use></g></g><g data-mml-node=\"mo\" transform=\"translate(2958.2,0)\"><use data-c=\"21CC\" xlink:href=\"#MJX-TEX-V-21CC\"></use></g><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\" transform=\"translate(4236,0)\"><g data-mml-node=\"mi\"><use data-c=\"43\" xlink:href=\"#MJX-TEX-N-43\"></use></g><g data-mml-node=\"mo\" transform=\"translate(944.2,0)\"><use data-c=\"2B\" xlink:href=\"#MJX-TEX-N-2B\"></use></g><g data-mml-node=\"mi\" transform=\"translate(1944.4,0)\"><use data-c=\"44\" xlink:href=\"#MJX-TEX-N-44\"></use></g></g></g></g></svg></mjx-container></p>\n<p>The forward rate constant, <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.667ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"2.246ex\" height=\"2.237ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -694 992.9 989\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"msub\"><g data-mml-node=\"mi\"><use data-c=\"1D458\" xlink:href=\"#MJX-TEX-I-1D458\"></use></g><g data-mml-node=\"mi\" transform=\"translate(554,-150) scale(0.707)\"><use data-c=\"1D453\" xlink:href=\"#MJX-TEX-I-1D453\"></use></g></g></g></g></svg></mjx-container>, is <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.05ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"3.25ex\" height=\"2.003ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -863.3 1436.6 885.3\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"msup\"><g data-mml-node=\"mn\"><use data-c=\"31\" xlink:href=\"#MJX-TEX-N-31\"></use><use data-c=\"30\" xlink:href=\"#MJX-TEX-N-30\" transform=\"translate(500,0)\"></use></g><g data-mml-node=\"mn\" transform=\"translate(1033,393.1) scale(0.707)\"><use data-c=\"33\" xlink:href=\"#MJX-TEX-N-33\"></use></g></g></g></g></svg></mjx-container>, and the reverse rate constant, <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.357ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"2.088ex\" height=\"1.927ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -694 922.9 851.8\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"msub\"><g data-mml-node=\"mi\"><use data-c=\"1D458\" xlink:href=\"#MJX-TEX-I-1D458\"></use></g><g data-mml-node=\"mi\" transform=\"translate(554,-150) scale(0.707)\"><use data-c=\"1D45F\" xlink:href=\"#MJX-TEX-I-1D45F\"></use></g></g></g></g></svg></mjx-container>, is <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.05ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"3.25ex\" height=\"2.005ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -864 1436.6 886\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"msup\"><g data-mml-node=\"mn\"><use data-c=\"31\" xlink:href=\"#MJX-TEX-N-31\"></use><use data-c=\"30\" xlink:href=\"#MJX-TEX-N-30\" transform=\"translate(500,0)\"></use></g><g data-mml-node=\"mn\" transform=\"translate(1033,393.1) scale(0.707)\"><use data-c=\"32\" xlink:href=\"#MJX-TEX-N-32\"></use></g></g></g></g></svg></mjx-container>. Therefore,</p>\n<p><mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -1.055ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"15.104ex\" height=\"3.328ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -1004.4 6676.2 1470.9\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"msub\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"4B\" xlink:href=\"#MJX-TEX-N-4B\"></use></g></g><g data-mml-node=\"TeXAtom\" transform=\"translate(811,-150) scale(0.707)\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"65\" xlink:href=\"#MJX-TEX-N-65\"></use><use data-c=\"71\" xlink:href=\"#MJX-TEX-N-71\" transform=\"translate(444,0)\"></use></g></g></g></g><g data-mml-node=\"mo\" transform=\"translate(1831,0)\"><use data-c=\"3D\" xlink:href=\"#MJX-TEX-N-3D\"></use></g><g data-mml-node=\"mfrac\" transform=\"translate(2886.8,0)\"><g data-mml-node=\"msup\" transform=\"translate(220,394) scale(0.707)\"><g data-mml-node=\"mn\"><use data-c=\"31\" xlink:href=\"#MJX-TEX-N-31\"></use><use data-c=\"30\" xlink:href=\"#MJX-TEX-N-30\" transform=\"translate(500,0)\"></use></g><g data-mml-node=\"mn\" transform=\"translate(1033,393.1) scale(0.707)\"><use data-c=\"33\" xlink:href=\"#MJX-TEX-N-33\"></use></g></g><g data-mml-node=\"msup\" transform=\"translate(220,-450.9) scale(0.707)\"><g data-mml-node=\"mn\"><use data-c=\"31\" xlink:href=\"#MJX-TEX-N-31\"></use><use data-c=\"30\" xlink:href=\"#MJX-TEX-N-30\" transform=\"translate(500,0)\"></use></g><g data-mml-node=\"mn\" transform=\"translate(1033,393.1) scale(0.707)\"><use data-c=\"32\" xlink:href=\"#MJX-TEX-N-32\"></use></g></g><rect width=\"1215.8\" height=\"60\" x=\"120\" y=\"220\"></rect></g><g data-mml-node=\"mo\" transform=\"translate(4620.4,0)\"><use data-c=\"3D\" xlink:href=\"#MJX-TEX-N-3D\"></use></g><g data-mml-node=\"mn\" transform=\"translate(5676.2,0)\"><use data-c=\"31\" xlink:href=\"#MJX-TEX-N-31\"></use><use data-c=\"30\" xlink:href=\"#MJX-TEX-N-30\" transform=\"translate(500,0)\"></use></g></g></g></svg></mjx-container></p>\n<p>Substitute the values into the Gibbs energy change formula:</p>\n<p><mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.186ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"17.578ex\" height=\"2.135ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -861.5 7769.5 943.5\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"mi\"><use data-c=\"394\" xlink:href=\"#MJX-TEX-N-394\"></use></g><g data-mml-node=\"msup\" transform=\"translate(833,0)\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"47\" xlink:href=\"#MJX-TEX-N-47\"></use></g></g><g data-mml-node=\"mi\" transform=\"translate(818,363) scale(0.707)\"><use data-c=\"1D703\" xlink:href=\"#MJX-TEX-I-1D703\"></use></g></g><g data-mml-node=\"mo\" transform=\"translate(2310.4,0)\"><use data-c=\"3D\" xlink:href=\"#MJX-TEX-N-3D\"></use></g><g data-mml-node=\"mo\" transform=\"translate(3366.2,0)\"><use data-c=\"2212\" xlink:href=\"#MJX-TEX-N-2212\"></use></g><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\" transform=\"translate(4144.2,0)\"><g data-mml-node=\"mi\"><use data-c=\"52\" xlink:href=\"#MJX-TEX-N-52\"></use><use data-c=\"54\" xlink:href=\"#MJX-TEX-N-54\" transform=\"translate(736,0)\"></use></g></g><g data-mml-node=\"mi\" transform=\"translate(5768.9,0)\"><use data-c=\"6C\" xlink:href=\"#MJX-TEX-N-6C\"></use><use data-c=\"6E\" xlink:href=\"#MJX-TEX-N-6E\" transform=\"translate(278,0)\"></use></g><g data-mml-node=\"mo\" transform=\"translate(6602.9,0)\"><use data-c=\"2061\" xlink:href=\"#MJX-TEX-N-2061\"></use></g><g data-mml-node=\"mn\" transform=\"translate(6769.5,0)\"><use data-c=\"31\" xlink:href=\"#MJX-TEX-N-31\"></use><use data-c=\"30\" xlink:href=\"#MJX-TEX-N-30\" transform=\"translate(500,0)\"></use></g></g></g></svg></mjx-container></p>\n<p>where <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.05ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"19.792ex\" height=\"2.068ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -892 8747.9 914\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"mi\"><use data-c=\"1D445\" xlink:href=\"#MJX-TEX-I-1D445\"></use></g><g data-mml-node=\"mo\" transform=\"translate(1036.8,0)\"><use data-c=\"3D\" xlink:href=\"#MJX-TEX-N-3D\"></use></g><g data-mml-node=\"mn\" transform=\"translate(2092.6,0)\"><use data-c=\"38\" xlink:href=\"#MJX-TEX-N-38\"></use><use data-c=\"2E\" xlink:href=\"#MJX-TEX-N-2E\" transform=\"translate(500,0)\"></use><use data-c=\"33\" xlink:href=\"#MJX-TEX-N-33\" transform=\"translate(778,0)\"></use></g><g data-mml-node=\"mspace\" transform=\"translate(3370.6,0)\"></g><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\" transform=\"translate(3537.6,0)\"><g data-mml-node=\"mi\"><use data-c=\"4A\" xlink:href=\"#MJX-TEX-N-4A\"></use></g><g data-mml-node=\"mspace\" transform=\"translate(514,0)\"></g><g data-mml-node=\"msup\" transform=\"translate(681,0)\"><g data-mml-node=\"mi\"><use data-c=\"4B\" xlink:href=\"#MJX-TEX-N-4B\"></use></g><g data-mml-node=\"TeXAtom\" transform=\"translate(811,363) scale(0.707)\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mo\"><use data-c=\"2212\" xlink:href=\"#MJX-TEX-N-2212\"></use></g><g data-mml-node=\"mn\" transform=\"translate(778,0)