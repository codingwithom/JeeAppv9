n<br><br>Na<sub>4</sub>[FeO<sub>4</sub>]\n<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;(B)\n<br><br>[Fe<sub>2</sub>(CO)<sub>9</sub>]\n<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;(C)","options":[],"correct_options":[],"answer":"6","explanation":"Na<sub>4</sub>[Fe(CN)<sub>5</sub>(NOS)]\n<br><br>Let the O.S. of Fe be x\n<br><br>OS of CN = –1\n<br>OS of NOS = –1\n<br><br><mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.186ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"1.509ex\" height=\"1.251ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -471 667 553\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"mo\"><use data-c=\"2234\" xlink:href=\"#MJX-TEX-N-2234\"></use></g></g></g></svg></mjx-container> (+1)4 + x + (–1)5 + (–1)1 = 0\n<br><br><mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.054ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"2.262ex\" height=\"1.242ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -525 1000 549\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"mo\"><use data-c=\"21D2\" xlink:href=\"#MJX-TEX-N-21D2\"></use></g></g></g></svg></mjx-container> x = +2\n<br><br>Na<sub>4</sub>[FeO<sub>4</sub>]\n<br><br>Let O.S. of Fe be y\n<br><br>(+1)4 + y + (–2)4 = 0\n<br><br><mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.054ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"2.262ex\" height=\"1.242ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -525 1000 549\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"mo\"><use data-c=\"21D2\" xlink:href=\"#MJX-TEX-N-21D2\"></use></g></g></g></svg></mjx-container> y = +4\n<br><br>[Fe<sub>2</sub>(CO)<sub>9</sub>]\n<br><br>Let O.S. of Fe be z\n<br><br>2z + 0 × 9 = 0\n<br><br><mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.054ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"2.262ex\" height=\"1.242ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -525 1000 549\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"mo\"><use data-c=\"21D2\" xlink:href=\"#MJX-TEX-N-21D2\"></use></g></g></g></svg></mjx-container> z = 0\n<br><br>so (x + y + z) = +2 + 4 + 0 = 6"},"hi":{"content":"यौगिकों (A), (B) और (C) में आयरन अणुओं के आक्सीकरण अवस्थाएँ क्रमशः x, y और z हैं। x, y और z का योग ________ है।\n<br><br>Na<sub>4</sub>[Fe(CN)<sub>5</sub>(NOS)]\n<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;(A)\n<br><br>Na<sub>4</sub>[FeO<sub>4</sub>]\n<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;(B)\n<br><br>[Fe<sub>2</sub>(CO)<sub>9</sub>]\n<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;(C)","options":[],"correct_options":[],"answer":"6","explanation":null,"comprehension":null,"direction":null}},"question_id":"R0AjCCgtKjUsBxa2hzjgy2xukewfveg0","updated_time":1605078819,"permalink":"the-oxidation-states-of-iron-atoms-in-compounds-a-b-and-jee-main-chemistry-coordination-compounds-tapitlxahllmydqk","paperId":"jee-main-2020-online-2nd-september-morning-slot","topic":"coordination-number","isOutOfSyllabus":false,"isBonus":false,"tags":[],"yearKey":"jee-main-2020-online-2nd-september-morning-slot","active":true},{"country":"in","examGroup":"jee","exam":"jee-main","subjectGroup":null,"subject":"chemistry","chapterGroup":"organic-chemistry","chapter":"biomolecules","year":2020,"paperTitle":"JEE Main 2020 (Online) 2nd September Morning Slot","timeAllotted":144000,"marks":4,"negMarks