orm=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"mover\"><g data-mml-node=\"mi\" transform=\"translate(131,0)\"><use data-c=\"1D438\" xlink:href=\"#MJX-TEX-I-1D438\"></use></g><g data-mml-node=\"mo\" transform=\"translate(114.5,796)\"><use data-c=\"2192\" xlink:href=\"#MJX-TEX-N-2192\"></use></g></g></g></g></svg></mjx-container><sub>2</sub>, and their superposition <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: 0;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"2.521ex\" height=\"3.183ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -1407 1114.5 1407\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"mover\"><g data-mml-node=\"mi\" transform=\"translate(131,0)\"><use data-c=\"1D438\" xlink:href=\"#MJX-TEX-I-1D438\"></use></g><g data-mml-node=\"mo\" transform=\"translate(114.5,796)\"><use data-c=\"2192\" xlink:href=\"#MJX-TEX-N-2192\"></use></g></g></g></g></svg></mjx-container><sub>12</sub> are given by</p>\n<p><mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -1.907ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"28.083ex\" height=\"5.124ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -1421.6 12412.8 2264.6\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"msub\"><g data-mml-node=\"mover\"><g data-mml-node=\"mi\" transform=\"translate(131,0)\"><use data-c=\"1D438\" xlink:href=\"#MJX-TEX-I-1D438\"></use></g><g data-mml-node=\"mo\" transform=\"translate(114.5,796)\"><use data-c=\"2192\" xlink:href=\"#MJX-TEX-N-2192\"></use></g></g><g data-mml-node=\"mn\" transform=\"translate(1121.5,-150) scale(0.707)\"><use data-c=\"31\" xlink:href=