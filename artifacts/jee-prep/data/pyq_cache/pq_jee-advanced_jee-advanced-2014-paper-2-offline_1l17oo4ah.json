goal.net/fly/500/image/1l17z24g9/3125aa02-3dfb-44a0-82db-79de7ef30122/6c75e6a0-ad14-11ec-abb2-4983f0354b7b/file-1l17z24ga.png?format=png 500w, https://app-content.cdn.examgoal.net/fly/750/image/1l17z24g9/3125aa02-3dfb-44a0-82db-79de7ef30122/6c75e6a0-ad14-11ec-abb2-4983f0354b7b/file-1l17z24ga.png?format=png 750w, https://app-content.cdn.examgoal.net/fly/1000/image/1l17z24g9/3125aa02-3dfb-44a0-82db-79de7ef30122/6c75e6a0-ad14-11ec-abb2-4983f0354b7b/file-1l17z24ga.png?format=png 1000w, https://app-content.cdn.examgoal.net/fly/1500/image/1l17z24g9/3125aa02-3dfb-44a0-82db-79de7ef30122/6c75e6a0-ad14-11ec-abb2-4983f0354b7b/file-1l17z24ga.png?format=png 1500w, https://app-content.cdn.examgoal.net/fly/2000/image/1l17z24g9/3125aa02-3dfb-44a0-82db-79de7ef30122/6c75e6a0-ad14-11ec-abb2-4983f0354b7b/file-1l17z24ga.png?format=png 2000w, https://app-content.cdn.examgoal.net/fly/2500/image/1l17z24g9/3125aa02-3dfb-44a0-82db-79de7ef30122/6c75e6a0-ad14-11ec-abb2-4983f0354b7b/file-1l17z24ga.png?format=png 2500w\" sizes=\"(max-width: 767px) 100vw, 720px\" decoding=\"async\"></p>\n<p>The correct order of their boiling point is</p>","options":[{"identifier":"A","content":"I > II > III"},{"identifier":"B","content":"III > II > I"},{"identifier":"C","content":"II > III > I"},{"identifier":"D","content":"III > I > III"}],"correct_options":["B"],"answer":null,"explanation":"<p>As the branching increases, the boiling point decreases. This is because the van der Waals forces of attraction decrease.</p>"}},"subject":"chemistry","subjectGroup":null,"timeAllotted":180000,"topic":"isomerism","type":"mcq","year":2014,"isOutOfSyllabus":false,"isBonus":false,"yearKey":"jee-advanced-2014-paper-2-offline","active":true},{"question_id":"1l17ovzg8","chapter":"alcohols-phenols-and-ethers","chapterGroup":"organic-chemistry","country":"in","difficulty":"medium","exam":"jee-advanced","examGroup":"jee","languages":["en"],"marks":3,"negMarks":1,"paperId":"jee-advanced-2014-paper-2-offline","paperTitle":"JEE Advanced 2014 Paper 2 Offline","permalink":"pthe-acidic-hydrolysis-of-ether-x-shown-below-is-fastest-jee-advanced-chemistry-some-basic-concepts-of-chemistry-gzuusmqo204iymn9","question":{"en":{"direction":null,"content":"<p>The acidic hydrolysis of ether (X) shown below is fastest when</p>\n<p><img src=\"https://app-content.cdn.examgoal.net/fly/1000/image/1l181b7e7/37521ed4-5f72-41d7-84ec-e3b0310add67/3b461bf0-ad1d-11ec-9281-4dfe83126473/file-1l181b7e8.png?format=png\" data-orsrc=\"https://app-content.cdn.examgoal.net/image/1l181b7e7/37521ed4-5f72-41d7-84ec-e3b0310add67/3b461bf0-ad1d-11ec-9281-4dfe83126473/file-1l181b7e8.png\" loading=\"lazy\" style=\"max-width:100%;height:auto;display:block;margin:0px auto;max-height:40vh\" alt=\"JEE Advanced 2014 Paper 2 Offline Chemistry - Alcohols, Phenols and Ethers Question 24 English\" srcset=\"https://app-content.cdn.examgoal.net/fly/500/image/1l181b7e7/37521ed4-5f72-41d7-84ec-e3b0310add67/3b461bf0-ad1d-11ec-9281-4dfe83126473/file-1l181b7e8.png?format=png 500w, https://app-content.cdn.examgoal.net/fly/750/image/1l181b7e7/37521ed4-5f72-41d7-84ec-e3b0310add67/3b461bf0-ad1d-11ec-9281-4dfe83126473/file-1l181b7e8.png?format=png 750w, https://app-content.cdn.examgoal.net/fly/1000/image/1l181b7e7/37521ed4-5f72-41d7-84ec-e3b0310add67/3b461bf0-ad1d-11ec-9281-4dfe83126473/file-1l181b7e8.png?format=png 1000w, https://app-content.cdn.examgoal.net/fly/1500/image/1l181b7e7/37521ed4-5f72-41d7-84ec-e3b0310add67/3b461bf0-ad1d-11ec-9281-4dfe83126473/file-1l181b7e8.png?format=png 1500w, https://app-content.cdn.examgoal.net/fly/2000/image/1l181b7e7/37521ed4-5f72-41d7-84ec-e3b0310add67/3b461bf0-ad1d-11ec-9281-4dfe83126473/file-1l181b7e8.png?format=png 2000w, https://app-content.cdn.examgoal.net/fly/2500/image/1l181b7e7/37521ed4-5f72-41d7-84ec-e3b0310add67/3b461bf0-ad1d-11ec-9281-4dfe83126473/file-1l181b7e8.png?format=png 2500w\" sizes=\"(max-width: 767px) 100vw, 720px\" decoding=\"async\"></p>","options":[{"identifier":"A","content":"one phenyl group is replaced by a methyl group."},{"identifier":"B","content":"one phenyl group is replaced by a para-methoxyphenyl group."},{"identifier":"C","content":"two phenyl groups are replaced by two para-methoxyphenyl groups."},{"identifier":"D","content":"no structural change is made to X."}],"correct_options":["C"],"answer":null,"explanation":"<p>The acidic hydrolysis is fastest when two phenyl groups are replaced by two para-methoxyphenyl groups.</p>\n<p>This is because <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.186ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"1.76ex\" height=\"1.505ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -583 778 665\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"mo\"><use data-c=\"2212\" xlink:href=\"#MJX-TEX-N-2212\"></use></g></g></g></svg></mjx-container>OCH<sub>3</sub> is an electron donating group which increases the stability of the carbocation.</p>\n<p><img src=\"https://app-content.cdn.examgoal.net/fly/1000/image/1l181gp3z/9ec78ddc-cf08-4692-8b27-8c581214b05d/d4013af0-ad1d-11ec-9281-4dfe83126473/file-1l181gp40.png?format=png\" data-orsrc=\"https://app-content.cdn.examgoal.net/image/1l181gp3z/9ec78ddc-cf08-4692-8b27-8c581214b05d/d4013af0-ad1d-11ec-9281-4dfe83126473/file-1l181gp40.png\" loading=\"lazy\" style=\"max-width:100%;height:auto;display:block;margin:0px auto;max-height:40vh\" alt=\"JEE Advanced 2014 Paper 2 Offline Chemistry - Alcohols, Phenols and Ethers Question 24 English Explanation\" srcset=\"https://app-content.cdn.examgoal.net/fly/500/image/1l181gp3z/9ec78ddc-cf08-4692-8b27-8c581214b05d/d4013af0-ad1d-11ec-9281-4dfe83126473/file-1l181gp40.png?format=png 500w, https://app-content.cdn.examgoal.net/fly/750/image/1l181gp3z/9ec78ddc-cf08-4692-8b27-8c581214b05d/d4013af0-ad1d-11ec-9281-4dfe83126473/file-1l181gp40.png?format=png 750