ef17-4f37-80ed-c3cf385ecd8c/b097a000-e263-11ed-8ec0-d5a0bb2b1e44/file-1lguf416p.png?format=png 2000w, https://app-content.cdn.examgoal.net/fly/2500/image/1lguf416o/118a7b5f-ef17-4f37-80ed-c3cf385ecd8c/b097a000-e263-11ed-8ec0-d5a0bb2b1e44/file-1lguf416p.png?format=png 2500w\" sizes=\"(max-width: 767px) 100vw, 720px\" decoding=\"async\"></p>\n<p>Because</p>\n<p>STATEMENT 2</p>\n<p>In the above situation, a current is induced in the ring which interacts with the horizontal component of the magnetic field to produce an average force in the upward direction.</p>","options":[{"identifier":"A","content":"Statement-1 is True, Statement-2 is True; Statement-2 is a correct explanation for Statement-1."},{"identifier":"B","content":"Statement-1 is True, Statement-2 is True; Statement-2 is NOT a correct explanation for Statement-1."},{"identifier":"C","content":"Statement-1 is True, Statement-2 is False."},{"identifier":"D","content":"Statement-1 is False, Statement-2 is True."}],"correct_options":["A"],"answer":null,"explanation":"<p>As shown in the figure, the horizontal component of the magnetic field interacts with the current in the conducting ring, which produces an average force in the upwards direction (by using Fleming's left hand rule).</p>\n<p><img src=\"https://app-content.cdn.examgoal.net/fly/1000/image/1lguf4zy6/71b405da-e87f-40dd-a136-f10b74c94305/cb7251e0-e263-11ed-8ec0-d5a0bb2b1e44/file-1lguf4zy7.png?format=png\" data-orsrc=\"https://app-content.cdn.examgoal.net/image/1lguf4zy6/71b405da-e87f-40dd-a136-f10b74c94305/cb7251e0-e263-11ed-8ec0-d5a0bb2b1e44/file-1lguf4zy7.png\" loading=\"lazy\" style=\"max-width:100%;height:auto;display:block;margin:0px auto;max-height:40vh\" alt=\"IIT-JEE 2007 Paper 2 Offline Physics - Alternating Current Question 8 English Explanation\" srcset=\"https://app-content.cdn.examgoal.net/fly/500/image/1lguf4zy6/71b405da-e87f-40dd-a136-f10b74c94305/cb7251e0-e263-11ed-8ec0-d5a0bb2b1e44/file-1lguf4zy7.png?format=png 500w, https://app-content