44F\"></use></g><g data-mml-node=\"mo\" transform=\"translate(818,0)\"><use data-c=\"2C\" xlink:href=\"#MJX-TEX-N-2C\"></use></g><g data-mml-node=\"mi\" transform=\"translate(1262.7,0)\"><use data-c=\"1D44E\" xlink:href=\"#MJX-TEX-I-1D44E\"></use></g><g data-mml-node=\"mo\" transform=\"translate(1791.7,0)\"><use data-c=\"29\" xlink:href=\"#MJX-TEX-N-29\"></use></g></g></g></svg></mjx-container> also exists, which would make the relation symmetric, contradicting our requirement.\"</p>\n\n<br>1. R<sub>1</sub> = {(1,1), (2,2), (3,3), (1,2), (2,3), (1,3)}\n\n  <br><br> Here, none of (2,1), (3,2), (3,1) are in R<sub>1</sub>. \n\n<br><br>2. R<sub>2</sub> = {(1,1), (2,2), (3,3), (1,2), (2,3), (1,3), (2,1)}\n\n<br><br>   Here, only (2,1) is in R<sub>2</sub>, and neither (3,2) nor (3,1) are in R<sub>2</sub>.\n\n<br><br>3. R<sub>3</sub> = {(1,1), (2,2), (3,3), (1,2), (2,3), (1,3), (3,2)}\n\n <br><br>  Here, only (3,2) is in R<sub>3</sub>, and neither (2,1) nor (3,1) are in R<sub>3</sub>."
