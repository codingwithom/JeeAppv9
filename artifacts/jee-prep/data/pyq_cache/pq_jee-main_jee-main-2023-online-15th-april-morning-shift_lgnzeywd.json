.examgoal.net/fly/2500/image/1lgo2dkys/50c6270e-fab9-4ebc-b850-69f656dd4507/2f945240-dee5-11ed-af59-7d40b6147d53/file-1lgo2dkyt.png?format=png 2500w\" sizes=\"(max-width: 767px) 100vw, 720px\" decoding=\"async\">"},{"identifier":"D","content":"<img src=\"https://app-content.cdn.examgoal.net/fly/1000/image/1lgo2e4gz/7c5005c8-ddbd-4193-8ef9-25f32409155f/3ea5be40-dee5-11ed-af59-7d40b6147d53/file-1lgo2e4h0.png?format=png\" data-orsrc=\"https://app-content.cdn.examgoal.net/image/1lgo2e4gz/7c5005c8-ddbd-4193-8ef9-25f32409155f/3ea5be40-dee5-11ed-af59-7d40b6147d53/file-1lgo2e4h0.png\" loading=\"lazy\" style=\"max-width:100%;height:auto;display:block;margin:0px auto;max-height:40vh\" alt=\"JEE Main 2023 (Online) 15th April Morning Shift Chemistry - Compounds Containing Nitrogen Question 92 Hindi Option 4\" srcset=\"https://app-content.cdn.examgoal.net/fly/500/image/1lgo2e4gz/7c5005c8-ddbd-4193-8ef9-25f32409155f/3ea5be40-dee5-11ed-af59-7d40b6147d53/file-1lgo2e4h0.png?format=png 500w, https://app-content.cdn.examgoal.net/fly/750/image/1lgo2e4gz/7c5005c8-ddbd-4193-8ef9-25f32409155f/3ea5be40-dee5-11ed-af59-7d40b6147d53/file-1lgo2e4h0.png?format=png 750w, https://app-content.cdn.examgoal.net/fly/1000/image/1lgo2e4gz/7c5005c8-ddbd-4193-8ef9-25f32409155f/3ea5be40-dee5-11ed-af59-7d40b6147d53/file-1lgo2e4h0.png?format=png 1000w, https://app-content.cdn.examgoal.net/fly/1500/image/1lgo2e4gz/7c5005c8-ddbd-4193-8ef9-25f32409155f/3ea5be40-dee5-11ed-af59-7d40b6147d53/file-1lgo2e4h0.png?format=png 1500w, https://app-content.cdn.examgoal.net/fly/2000/image/1lgo2e4gz/7c5005c8-ddbd-4193-8ef9-25f32409155f/3ea5be40-dee5-11ed-af59-7d40b6147d53/file-1lgo2e4h0.png?format=png 2000w, https://app-content.cdn.examgoal.net/fly/2500/image/1lgo2e4gz/7c5005c8-ddbd-4193-8ef9-25f32409155f/3ea5be40-dee5-11ed-af59-7d40b6147d53/file-1lgo2e4h0.png?format=png 2500w\" sizes=\"(max-width: 767px) 100vw, 720px\" decoding=\"async\">"}],"correct_options":["A"],"answer":null,"explanation":null}},"subject":"chemistry","timeAllotted":120000,"topic":"diazonium-salts-and-other-nitrogen-containing-compounds","type":"mcq","year":2023,"isOutOfSyllabus":false,"isBonus":false,"tags":[],"yearKey":"jee-main-2023-online-15th-april-morning-shift","active":true},{"question_id":"lgnzntql","chapter":"structure-of-atom","chapterGroup":"physical-chemistry","country":"in","difficulty":"medium","exam":"jee-main","examGroup":"jee","languages":["en","hi"],"marks":4,"negMarks":1,"paperId":"jee-main-2023-online-15th-april-morning-shift","paperTitle":"JEE Main 2023 (Online) 15th April Morning Shift","permalink":"given-below-are-two-statements-brbr-bstatement-ib-jee-main-chemistry-ib1y3b2jquqp1eaq","question":{"en":{"comprehension":null,"direction":null,"content":"Given below are two statements:\n<br/><br/>\n<b>Statement I</b> : According to Bohr's model of hydrogen atom, the angular momentum of an electron in a given stationary state is quantised.\n<br/><br/>\n<b>Statement II</b> : The concept of electron in Bohr's orbit, violates the Heisenberg uncertainty principle.\n<br/><br/>\nIn the light of the above statements, choose the most appropriate answer from the options given below:\n","options":[{"identifier":"A","content":"Both Statement I and Statement II are incorrect"},{"identifier":"B","content":"Statement I is correct but Statement II is incorrect"},{"identifier":"C","content":"Both Statement I and Statement II are correct"},{"identifier":"D","content":"Statement I is incorrect but Statement II is correct"}],"correct_options":["C"],"answer":null,"explanation":"Both Statement I and Statement II are correct\n<br><br>\nStatement I is correct. According to Bohr's model of the hydrogen atom, the angular momentum of an electron in a given stationary state is quantized. The angular momentum of an electron in the nth orbit is given by:\n<br><br>\n<mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.798ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"14.273ex\" height=\"2.8ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -884.7 6308.8 1237.5\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"mi\"><use data-c=\"1D43F\" xlink:href=\"#MJX-TEX-I-1D43F\"></use></g><g data-mml-node=\"mo\" transform=\"translate(958.8,0)\"><use data-c=\"3D\" xlink:href=\"#MJX-TEX-N-3D\"></use></g><g data-mml-node=\"mi\" transform=\"translate(2014.6,0)\"><use data-c=\"1D45B\" xlink:href=\"#MJX-TEX-I-1D45B\"></use></g><g data-mml-node=\"mi\" transform=\"translate(2614.6,0)\"><use data-c=\"210F\" xlink:href=\"#MJX-TEX-V-210F\"></use></g><g data-mml-node=\"mo\" transform=\"translate(3454.3,0)\"><use data-c=\"3D\" xlink:href=\"#MJX-TEX-N-3D\"></use></g><g data-mml-node=\"mi\" transform=\"translate(4510.1,0)\"><use data-c=\"1D45B\" xlink:href=\"#MJX-TEX-I-1D45B\"></use></g><g data-mml-node=\"mfrac\" transform=\"translate(5110.1,0)\"><g data-mml-node=\"mi\" transform=\"translate(395.7,394) scale(0.707)\"><use data-c=\"210E\" xlink:href=\"#MJX-TEX-I-210E\"></use></g><g data-mml-node=\"mrow\" transform=\"translate(220,-345) scale(0.707)\"><g data-mml-node=\"mn\"><use data-c=\"32\" xlink:href=\"#MJX-TEX-N-32\"></use></g><g data-mml-node=\"mi\" transform=\"translate(500,0)\"><use data-c=\"1D70B\" xlink:href=\"#MJX-TEX-I-1D70B\"></use></g></g><rect width=\"958.7\" height=\"60\" x=\"120\" y=\"220\"></rect></g></g></g></svg></mjx-container>\n<br><br>\nwhere n is an integer (quantum number), and h is the Planck's constant.\n<br><br>\nStatement II is also correct. Bohr's model does not consider the Heisenberg uncertainty principle, which states that it is impossible to know the exact position and momentum of an electron simultaneously. In Bohr's model, electrons are assumed to move in well-defined orbits with quantized angular momentum, which implies knowledge of both position and momentum, thus violating the Heisenberg uncertainty principle."},"hi":{"direction":null,"comprehension":null,"content":"<p>नीचे दो कथन गए हैं:</p>\n<p>कथन। : हाइड्रोजन परमाणु के बोर मॉडल के अनुसार, किसी स्थायी कक्षा में इलेक्ट्रॉन का कोणीय संवेग क्रांटीकृत है ।</p>\n<p>कथन ॥ : बोर कक्षा में इलेक्ट्रॉन की संकल्पना, हाइजेनबर्ग के अनिश्चितता सिद्धांत का पालन नहीं करता है।</p>\n<p>उपर्युक्त कथनों के संदर्भ में, नीचे दिए गए विकल्पों में से सर्वाधिक उपयुक्त उत्तर चुनें:</p>","options":[{"identifier":"A","content":"कथन । एवं कथन II दोनों गलत हैं।"},{"identifier":"B","content":"कथन। सही है परन्तु कथन II गलत है।"},{"identifier":"C","content":"कथन । एवं कथन II दोनों सही हैं।"},{"identifier":"D","content":"कथन। गलत है परन्तु कथन ॥ सही है।"}],"correct_options":["C"],"answer":null,"explanation":null}},"subject":"chemistry","timeAllotted":120000,"topic":"bohrs-model-for-hydrogen-atom","type":"mcq","year":2023,"isOutOfSyllabus":false,"isBonus":false,"tags":["assertion_reason"],"yearKey":"jee-main-2023-online-15th-april-morning-shift","active":true}],"ids":["lgnzeywd","lgnzgm5p","lgnzj56q","lgnzntql"],"title":"JEE Main 2023 (Online) 15th April Morning Shift | JEE Main Year Wise Previous Years Questions","canonical":"https://app/past-years/jee/which-of-the-following-statement-is-correct-for-paper-chroma-jee-main-chemistry-aph1uwbwrsqlwpcz"}