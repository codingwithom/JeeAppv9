          "content": "41x + 25y − 25 = 0"
        },
        {
          "identifier": "C",
          "content": "41x + 38y − 38 = 0"
        },
        {
          "identifier": "D",
          "content": "41x − 25y + 25 = 0"
        }
      ],
      "correct_options": [
        "A"
      ],
