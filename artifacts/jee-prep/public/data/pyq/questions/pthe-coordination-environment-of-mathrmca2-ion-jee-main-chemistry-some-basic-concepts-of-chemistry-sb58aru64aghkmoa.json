-N-32\"></use></g><g data-mml-node=\"mo\" transform=\"translate(500,0)\"><use data-c=\"2B\" xlink:href=\"#MJX-TEX-N-2B\"></use></g></g></g></g></g></svg></mjx-container> आयन का समन्वय परिवेश जब यह <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: 0;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"8.832ex\" height=\"2.085ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -921.8 3903.7 921.8\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"msup\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"45\" xlink:href=\"#MJX-TEX-N-45\"></use><use data-c=\"44\" xlink:href=\"#MJX-TEX-N-44\" transform=\"translate(681,0)\"></use><use data-c=\"54\" xlink:href=\"#MJX-TEX-N-54\" transform=\"translate(1445,0)\"></use><use data-c=\"41\" xlink:href=\"#MJX-TEX-N-41\" transform=\"translate(2167,0)\"></use></g></g><g data-mml-node=\"TeXAtom\" transform=\"translate(2950,443.1) scale(0.707)\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mn\"><use data-c=\"34\" xlink:href=\"#MJX-TEX-N-34\"></use></g><g data-mml-node=\"mo\" transform=\"translate(500,0)\"><use data-c=\"2212\" xlink:href=\"#MJX-TEX-N-2212\"></use></g></g></g></g></g></svg></mjx-container> (एथिलीनडायमीनटेट्राएसिटिक अम्ल) के साथ संकुल बनाता है, अष्टफलकीय होता है। एथिलीनडायमीनटेट्राएसिटिक अम्ल (EDTA) एक षट्‌दंतुर लिगैंड है, जिसका अर्थ है कि इसमें छह दाता परमाणु होते हैं जो एक केंद्रीय धातु आयन से बंध सकते हैं। EDTA के मामले में, ये दाता परमाणु इसके चार कार्बोक्सिल समूहों से चार ऑक्सीजन परमाणु और इसके दो एमीन समूहों से दो नाइट्रोजन परमाणु हैं।</p>\n\n<p>जब <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.048ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"4.997ex\" height=\"2.09ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -903 2208.7 924\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"msup\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"43\" xlink:href=\"#MJX-TEX-N-43\"></use><use data-c=\"61\" xlink:href=\"#MJX-TEX-N-61\" transform=\"translate(722,0)\"></use></g></g><g data-mml-node=\"TeXAtom\" transform=\"translate(1255,432.1) scale(0.707)\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mn\"><use data-c=\"32\" xlink:href=\"#MJX-TEX-N-32\"></use></g><g data-mml-node=\"mo\" transform=\"translate(500,0)\"><use data-c=\"2B\" xlink:href=\"#MJX-TEX-N-2B\"></use></g></g></g></g></g></svg></mjx-container>, <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: 0;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"8.832ex\" height=\"2.085ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -921.8 3903.7 921.8\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"msup\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"45\" xlink:href=\"#MJX-TEX-N-45\"></use><use data-c=\"44\" xlink:href=\"#MJX-TEX-N-44\" transform=\"translate(681,0)\"></use><use data-c=\"54\" xlink:href=\"#MJX-TEX-N-54\" transform=\"translate(1445,0)\"></use><use data-c=\"41\" xlink:href=\"#MJX-TEX-N-41\" transform=\"translate(2167,0)\"></use></g></g><g data-mml-node=\"TeXAtom\" transform=\"translate(2950,443.1) scale(0.707)\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mn\"><use data-c=\"34\" xlink:href=\"#MJX-TEX-N-34\"></use></g><g data-mml-node=\"mo\" transform=\"translate(500,0)\"><use data-c=\"2212\" xlink:href=\"#MJX-TEX-N-2212\"></use></g></g></g></g></g></svg></mjx-container> के साथ संकुल बनाता है, तो EDTA के सभी छह दाता परमाणु कैल्शियम आयन के साथ समन्वित होते हैं। परिणामस्वरूप, कैल्शियम आयन की समन्वय संख्या 6 होती है, जो अष्टफलकीय ज्यामिति की ओर ले जाती है। ऐसा इसलिए है क्योंकि अष्टफलकीय ज्यामिति समन्वय संख्या 6 के लिए सबसे सामान्य और ऊर्जावान रूप से अनुकूल व्यवस्था है। ऐसी ज्यामिति में, छह लिगैंड केंद्रीय आयन से समान दूरी पर और आसन्न लिगैंडों के सापेक्ष 90° कोणों पर रखे जाते हैं, जो प्रतिकर्षण को न्यूनतम करने के लिए सभी लिगैंडों के बीच की दूरी को अधिकतम करते हैं।</p>\n\n<p>सही उत्तर <strong>विकल्प B</strong> है, अष्टफलकीय।</p>"}},"subject":"chemistry","subjectGroup":null,"timeAllotted":120000,"topic":"warners-theory-and-valence-bond-theory","type":"mcq","year":2024,"isOutOfSyllabus":false,"isBonus":false,"tags":[],"yearKey":"jee-main-2024-online-9th-april-evening-shift","active":true,"options":[{"identifier":"A","content":"trigonal prismatic\n"},{"identifier":"B","content":"octahedral\n"},{"identifier":"C","content":"square planar\n"},{"identifier":"D","content":"tetrahedral"}],"correct_options":["B"],"explanation":"<p>The coordination environment of the <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.048ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"4.997ex\" height=\"2.09ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -903 2208.7 924\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"msup\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"43\" xlink:href=\"#MJX-TEX-N-43\"></use><use data-c=\"61\" xlink:href=\"#MJX-TEX-N-61\" transform=\"translate(722,0)\"></use></g></g><g data-mml-node=\"TeXAtom\" transform=\"translate(1255,432.1) scale(0.707)\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mn\"><use data-c=\"32\" xlink:href=\"#MJX-TEX-N-32\"></use></g><g data-mml-node=\"mo\" transform=\"translate(500,0)\"><use data-c=\"2B\" xlink:href=\"#MJX-TEX-N-2B\"></use></g></g></g></g></g></svg></mjx-container> ion when it forms a complex with <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: 0;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"8.832ex\" height=\"2.085ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -921.8 3903.7 921.8\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"msup\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"45\" xlink:href=\"#MJX-TEX-N-45\"></use><use data-c=\"44\" xlink:href=\"#MJX-TEX-N-44\" transform=\"translate(681,0)\"></use><use data-c=\"54\" xlink:href=\"#MJX-TEX-N-54\" transform=\"translate(1445,0)\"></use><use data-c=\"41\" xlink:href=\"#MJX-TEX-N-41\" transform=\"translate(2167,0)\"></use></g></g><g data-mml-node=\"TeXAtom\" transform=\"translate(2950,443.1) scale(0.707)\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mn\"><use data-c=\"34\" xlink:href=\"#MJX-TEX-N-34\"></use></g><g data-mml-node=\"mo\" transform=\"translate(500,0)\"><use data-c=\"2212\" xlink:href=\"#MJX-TEX-N-2212\"></use></g></g></g></g></g></svg></mjx-container> (ethylenediaminetetraacetic acid) is octahedral. Ethylenediaminetetraacetic acid (EDTA) is a hexadentate ligand, which means it has six donor atoms that can bind to a central metal ion. In the case of EDTA, these donor atoms are four oxygen atoms from its four carboxyl groups and two nitrogen atoms from its two amine groups. </p>\n\n<p>When <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.048ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"4.997ex\" height=\"2.09ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -903 2208.7 924\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"msup\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"43\" xlink:href=\"#MJX-TEX-N-43\"></use><use data-c=\"61\" xlink:href=\"#MJX-TEX-N-61\" transform=\"translate(722,0)\"></use></g></g><g data-mml-node=\"TeXAtom\" transform=\"translate(1255,432.1) scale(0.707)\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mn\"><use data-c=\"32\" xlink:href=\"#MJX-TEX-N-32\"></use></g><g data-mml-node=\"mo\" transform=\"translate(500,0)\"><use data-c=\"2B\" xlink:href=\"#MJX-TEX-N-2B\"></use></g></g></g></g></g></svg></mjx-container> forms a complex with <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: 0;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"8.832ex\" height=\"2.085ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -921.8 3903.7 921.8\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"msup\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"45\" xlink:href=\"#MJX-TEX-N-45\"></use><use data-c=\"44\" xlink:href=\"#MJX-TEX-N-44\" transform=\"translate(681,0)\"></use><use data-c=\"54\" xlink:href=\"#MJX-TEX-N-54\" transform=\"translate(1445,0)\"></use><use data-c=\"41\" xlink:href=\"#MJX-TEX-N-41\" transform=\"translate(2167,0)\"></use></g></g><g data-mml-node=\"TeXAtom\" transform=\"translate(2950,443.1) scale(0.707)\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mn\"><use data-c=\"34\" xlink:href=\"#MJX-TEX-N-34\"></use></g><g data-mml-node=\"mo\" transform=\"translate(500,0)\"><use data-c=\"2212\" xlink:href=\"#MJX-TEX-N-2212\"></use></g></g></g></g></g></svg></mjx-container>, all six donor atoms from EDTA coordinate with the calcium ion. As a result, the coordination number of the calcium ion is 6, leading to an octahedral geometry. This is because the octahedral geometry is the most common and energetically favorable arrangement for a coordination number of 6. In such a geometry, the six ligands are placed at equal distances from the central ion and at 90° angles relative to adjacent ligands, maximizing the distance between all ligands to minimize repulsion.</p>\n\n<p>The correct answer is <strong>Option B</strong>, octahedral.</p>"}]}