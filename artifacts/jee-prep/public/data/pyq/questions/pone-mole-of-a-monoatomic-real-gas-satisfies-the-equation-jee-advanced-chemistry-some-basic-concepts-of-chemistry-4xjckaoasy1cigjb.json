8,0)\"><use data-c=\"1D44F\" xlink:href=\"#MJX-TEX-I-1D44F\"></use></g><g data-mml-node=\"mo\" transform=\"translate(7396.8,0)\"><use data-c=\"5D\" xlink:href=\"#MJX-TEX-N-5D\"></use></g><g data-mml-node=\"mo\" transform=\"translate(7952.6,0)\"><use data-c=\"3D\" xlink:href=\"#MJX-TEX-N-3D\"></use></g><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\" transform=\"translate(9008.4,0)\"><g data-mml-node=\"mi\"><use data-c=\"52\" xlink:href=\"#MJX-TEX-N-52\"></use><use data-c=\"54\" xlink:href=\"#MJX-TEX-N-54\" transform=\"translate(736,0)\"></use></g></g><g data-mml-node=\"mtext\" style=\"font-family: Roboto,'Tiro Devanagari Hindi','Tiro Bangla',sans-serif;\" transform=\"translate(10466.4,0)\"><text data-variant=\"-explicitFont\" transform=\"scale(1,-1)\" font-size=\"884px\"> we get </text></g><g data-mml-node=\"mi\" transform=\"translate(15266.4,0)\"><use data-c=\"1D44E\" xlink:href=\"#MJX-TEX-I-1D44E\"></use></g><g data-mml-node=\"mo\" transform=\"translate(16073.2,0)\"><use data-c=\"3D\" xlink:href=\"#MJX-TEX-N-3D\"></use></g><g data-mml-node=\"mn\" transform=\"translate(17129,0)\"><use data-c=\"30\" xlink:href=\"#MJX-TEX-N-30\"></use></g></g></g></svg></mjx-container>\n<br><br>Hence, only repulsive forces are present which are contributive only at very close distance.\n<br><br>Thus, the potential energy will increase abruptly, so graph (c) is correct. The dominance of repulsive force can be shown by using the compressibility factor.\n<br><br><mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -7.667ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"20.614ex\" height=\"16.466ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -3889 9111.4 7278\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"mtable\"><g data-mml-node=\"mtr\" transform=\"translate(0,3139)\"><g data-mml-node=\"mtd\"><g d