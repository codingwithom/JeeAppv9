      "content": "The total number of possible isomers for square-planar [Pt(Cl)(NO<sub>2</sub>)(NO<sub>3</sub>)(SCN)]<sup>2-</sup> is :",
      "options": [
        {
          "identifier": "A",
          "content": "8"
        },
        {
          "identifier": "B",
          "content": "12"
        },
        {
