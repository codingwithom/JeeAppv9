.1,0)\"><g data-mml-node=\"mi\"><use data-c=\"1D44B\" xlink:href=\"#MJX-TEX-I-1D44B\"></use></g><g data-mml-node=\"mn\" transform=\"translate(861,-150) scale(0.707)\"><use data-c=\"31\" xlink:href=\"#MJX-TEX-N-31\"></use></g></g><g data-mml-node=\"mtext\" style=\"font-family: Roboto,'Tiro Devanagari Hindi','Tiro Bangla',sans-serif;\" transform=\"translate(3862.7,0)\"><text data-variant=\"-explicitFont\" transform=\"scale(1,-1)\" font-size=\"884px\"> और </text></g><g data-mml-node=\"msub\" transform=\"translate(6262.7,0)\"><g data-mml-node=\"mi\"><use data-c=\"1D44B\" xlink:href=\"#MJX-TEX-I-1D44B\"></use></g><g data-mml-node=\"mn\" transform=\"translate(861,-150) scale(0.707)\"><use data-c=\"33\" xlink:href=\"#MJX-TEX-N-33\"></use></g></g><g data-mml-node=\"mo\" transform=\"translate(7805,0)\"><use data-c=\"3E\" xlink:href=\"#MJX-TEX-N-3E\"></use></g><g data-mml-node=\"msub\" transform=\"translate(8860.8,0)\"><g data-mml-node=\"mi\"><use data-c=\"1D44B\" xlink:href=\"#MJX-TEX-I-1D44B\"></use></g><g data-mml-node=\"mn\" transform=\"translate(861,-150) scale(0.707)\"><use data-c=\"32\" xlink:href=\"#MJX-TEX-N-32\"></use></g></g></g></g></svg></mjx-container></p>\n\n<p>पासे को तीन बार फेंकने पर कुल परिणामों की संख्या है: </p>\n\n<p><mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.05ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"8.53ex\" height=\"1.935ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -833.2 3770.1 855.2\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"msup\"><g data-mml-node=\"mn\"><use data-c=\"36\" xlink:href=\"#MJX-TEX-N-36\"></use></g><g data-mml-node=\"mn\" transform=\"translate(533,363) scale(0.707)\"><use data-c=\"33\" xlink:href=\"#MJX-TEX-N-33\"></use></g></g><g data-mml-node=\"mo\" transform=\"translate(1214.3,0)\"><use data-c=\"3D\" xlink:href=\"#MJX-TEX-N-3D\"></use></g><g data-mml-node=\"mn\" transform=\"translate(2270.1,0)\"><use data-c=\"32\" xlink:href=\"#MJX-TEX-N-32\"></use><use data-c=\"31\" xlink:href=\"#MJX-TEX-N-31\" transform=\"translate(500,0)\"></use><use data-c=\"36\" xlink:href=\"#MJX-TEX-N-36\" transform=\"translate(1000,0)\"></use></g></g></g></svg></mjx-container></p>\n\n<p>आइए अनुकूल परिणामों की गणना करें। प्रत्येक संतोषजनक परिणाम के लिए, हमें यह सुनिश्चित करना होगा कि दोनों असमिकाओं का पालन किया जाए। उन संभावित अनुक्रमों पर विचार करें जहाँ प्रत्येक बाद के रोल की संख्या पिछले रोल की संख्या से अधिक है। ये अनुक्रम हैं:</p>\n\n<ul>\n\n<li>(1, 2, 3)</li>\n\n<li>(1, 2, 4)</li>\n\n<li>(1, 2, 5)</li>\n\n<li>(1, 2, 6)</li>\n\n<li>(1, 3, 4)</li>\n\n<li>(1, 3, 5)</li>\n\n<li>(1, 3, 6)</li>\n\n<li>(1, 4, 5)</li>\n\n<li>(1, 4, 6)</li>\n\n<li>(1, 5, 6)</li>\n\n<li>(2, 3, 4)</li>\n\n<li>(2, 3, 5)</li>\n\n<li>(2, 3, 6)</li>\n\n<li>(2, 4, 5)</li>\n\n<li>(2, 4, 6)</li>\n\n<li>(2, 5, 6)</li>\n\n<li>(3, 4, 5)</li>\n\n<li>(3, 4, 6)</li>\n\n<li>(3, 5, 6)</li>\n\n<li>(4, 5, 6)</li>\n\n</ul>\n\n<p>स्पष्ट रूप से, ऐसे 20 अनुकूल परिणाम हैं। अतः, प्रायिकता इस प्रकार दी गई है:</p>\n\n<p><mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -1.158ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"37.017ex\" height=\"3.447ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -1011.8 16361.5 1523.5\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"mfrac\"><g data-mml-node=\"mtext\" style=\"font-family: Roboto,'Tiro Devanagari Hindi','Tiro Bangla',sans-serif;\" transform=\"translate(220,481.4) scale(0.707)\"><text data-variant=\"-explicitFont\" transform=\"scale(1,-1)\" font-size=\"884px\">अनुकूल परिणामों की संख्या</text></g><g data-mml-node=\"mtext\" style=\"font-family: Roboto,'Tiro Devanagari Hindi','Tiro Bangla',sans-serif;\" transform=\"translate(856.4