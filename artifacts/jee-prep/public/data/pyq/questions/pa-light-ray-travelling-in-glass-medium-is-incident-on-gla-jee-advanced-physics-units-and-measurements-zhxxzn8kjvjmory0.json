debf43c0-c8e7-11ec-8c2d-13f33da2fbe1/file-1l2mklrel.png?format=png 1000w, https://app-content.cdn.examgoal.net/fly/1500/image/1l2mklrek/813e977d-9d72-4114-a2ac-43242555ea54/debf43c0-c8e7-11ec-8c2d-13f33da2fbe1/file-1l2mklrel.png?format=png 1500w, https://app-content.cdn.examgoal.net/fly/2000/image/1l2mklrek/813e977d-9d72-4114-a2ac-43242555ea54/debf43c0-c8e7-11ec-8c2d-13f33da2fbe1/file-1l2mklrel.png?format=png 2000w, https://app-content.cdn.examgoal.net/fly/2500/image/1l2mklrek/813e977d-9d72-4114-a2ac-43242555ea54/debf43c0-c8e7-11ec-8c2d-13f33da2fbe1/file-1l2mklrel.png?format=png 2500w\" sizes=\"(max-width: 767px) 100vw, 720px\" decoding=\"async\">"},{"identifier":"D","content":"<img src=\"https://app-content.cdn.examgoal.net/fly/1000/image/1l2mkmqwg/66dfab29-6a0b-4880-9b1c-f7ccaa146afe/fa2b1210-c8e7-11ec-8c2d-13f33da2fbe1/file-1l2mkmqwh.png?format=png\" data-orsrc=\"https://app-content.cdn.examgoal.net/image/1l2mkmqwg/66dfab29-6a0b-4880-9b1c-f7ccaa146afe/fa2b1210-c8e7-11ec-8c2d-13f33da2fbe1/file-1l2mkmqwh.png\" loading=\"lazy\" style=\"max-width:100%;height:auto;display:block;margin:0px auto;max-height:40vh\" alt=\"IIT-JEE 2011 Paper 2 Offline Physics - Wave Optics Question 13 English Option 4\" srcset=\"https://app-content.cdn.examgoal.net/fly/500/image/1l2mkmqwg/66dfab29-6a0b-4880-9b1c-f7ccaa146afe/fa2b1210-c8e7-11ec-8c2d-13f33da2fbe1/file-1l2mkmqwh.png?format=png 500w, https://app-content.cdn.examgoal.net/fly/750/image/1l2mkmqwg/66dfab29-6a0b-4880-9b1c-f7ccaa146afe/fa2b1210-c8e7-11ec-8c2d-13f33da2fbe1/file-1l2mkmqwh.png?format=png 750w, https://app-content.cdn.examgoal.net/fly/1000/image/1l2mkmqwg/66dfab29-6a0b-4880-9b1c-f7ccaa146afe/fa2b1210-c8e7-11ec-8c2d-13f33da2fbe1/file-1l2mkmqwh.png?format=png 1000w, https://app-content.cdn.examgoal.net/fly/1500/image/1l2mkmqwg/66dfab29-6a0b-4880-9b1c-f7ccaa146afe/fa2b1210-c8e7-11ec-8c2d-13f33da2fbe1/file-1l2mkmqwh.png?format=png 1500w, https://app-content.cdn.examgoal.net/fly/2000/image/1l2mkmqwg/66dfab29-6a0b-4880-9b1c-f7ccaa146afe/fa2b1210-c8e7-11ec-8c2d-13f33da2fbe1/file-1l2mkmqwh.png?format=png 2000w, https://app-content.cdn.examgoal.net/fly/2500/image/1l2mkmqwg/66dfab29-6a0b-4880-9b1c-f7ccaa146afe/fa2b1210-c8e7-11ec-8c2d-13f33da2fbe1/file-1l2mkmqwh.png?format=png 2500w\" sizes=\"(max-width: 767px) 100vw, 720px\" decoding=\"async\">"}],"correct_options":["C"],"explanation":"<p>If I is the intensity of the incident light then R + T = I. Since the incident ray is travelling in a denser medium (glass), it will be totally reflected at a certain critical angle <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.023ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"1.061ex\" height=\"1.618ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -705 469 715\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"mi\"><use data-c=\"1D703\" xlink:href=\"#MJX-TEX-I-1D703\"></use></g></g></g></svg></mjx-container><sub>c</sub>. For <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.023ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"1.061ex\" height=\"1.618ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -705 469 715\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"mi\"><use data-c=\"1D703\" xlink:href=\"#MJX-TEX-I-1D703\"></use></g></g></g></svg></mjx-container> &lt; <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.023ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"1.061ex\" height=\"1.618ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -705 469 715\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"mi\"><use data-c=\"1D703\" xlink:href=\"#MJX-TEX-I-1D703\"></use></g></g></g></svg></mjx-container><sub>c</sub> a part of the incident intensity is reflected and the remaining part is transmitted. But for <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.023ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"1.061ex\" height=\"1.618ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -705 469 715\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"mi\"><use data-c=\"1D703\" xlink:href=\"#MJX-TEX-I-1D703\"></use></g></g></g></svg></mjx-container> &gt; <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.023ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"1.061ex\" height=\"1.618ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -705 469 715\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"mi\"><use data-c=\"1D703\" xlink:href=\"#MJX-TEX-I-1D703\"></use></g></g></g></svg></mjx-container><sub>c</sub>, there is no refracted ray. Hence for <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.023ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"1.061ex\" height=\"1.618ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -705 469 715\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"mi\"><use data-c=\"1D703\" xlink:href=\"#MJX-TEX-I-1D703\"></use></g></g></g></svg></mjx-container> &gt; <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.023ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"1.061ex\" height=\"1.618ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -705 469 715\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"mi\"><use data-c=\"1D703\" xlink:href=\"#MJX-TEX-I-1D703\"></use></g></g></g></svg></mjx-container><sub>c</sub>, the value of R is 100%. Hence the only correct option is (c).</p>"}]}