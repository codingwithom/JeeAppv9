      "content": "<p>Match List - I with List - II:</p>\n<p>\n<table class=\"tg\" style=\"undefined;table-layout: fixed; width: 554px\">\n<colgroup>\n<col style=\"width: 49px\">\n<col style=\"width: 201px\">\n<col style=\"width: 54px\">\n<col style=\"width: 250px\">\n</colgroup>\n<thead>\n  <tr>\n    <th class=\"tg-amwm\"></th>\n    <th class=\"tg-amwm\">List - I Species</th>\n    <th class=\"tg-amwm\"></th>\n    <th class=\"tg-amwm\">List - II Geometry/Shape</th>\n  </tr>\n</thead>\n<tbody>\n  <tr>\n    <td class=\"tg-baqh\">A.</td>\n    <td class=\"tg-baqh\"><mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.375ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"5.877ex\" height=\"2.129ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -775.2 2597.7 940.8\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"msub\"><g data-mml-node=\"mi\"><use data-c=\"48\" xlink:href=\"#MJX-TEX-N-48\"></use></g><g data-mml-node=\"mn\" transform=\"translate(783,-150) scale(0.707)\"><use data-c=\"33\" xlink:href=\"#MJX-TEX-N-33\"></use></g></g><g data-mml-node=\"msup\" transform=\"translate(1186.6,0)\"><g data-mml-node=\"mi\"><use data-c=\"4F\" xlink:href=\"#MJX-TEX-N-4F\"></use></g><g data-mml-node=\"mo\" transform=\"translate(811,363) scale(0.707)\"><use data-c=\"2B\" xlink:href=\"#MJX-TEX-N-2B\"></use></g></g></g></g></g></svg></mjx-container></td>\n    <td class=\"tg-baqh\">I.</td>\n    <td class=\"tg-baqh\">Tetrahedral</td>\n  </tr>\n  <tr>\n    <td class=\"tg-baqh\">B.</td>\n    <td class=\"tg-baqh\">Acetylide anion</td>\n    <td class=\"tg-baqh\">II.</td>\n    <td class=\"tg-baqh\">Linear</td>\n  </tr>\n  <tr>\n    <td class=\"tg-baqh\">C.</td>\n    <td class=\"tg-baqh\"><mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg styl