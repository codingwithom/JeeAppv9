MJX-TEX-N-46\"></use><use data-c=\"65\" xlink:href=\"#MJX-TEX-N-65\" transform=\"translate(653,0)\"></use></g></g><g data-mml-node=\"mn\" transform=\"translate(1130,-150) scale(0.707)\"><use data-c=\"34\" xlink:href=\"#MJX-TEX-N-34\"></use></g></g><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\" transform=\"translate(1533.6,0)\"><g data-mml-node=\"mo\"><use data-c=\"5B\" xlink:href=\"#MJX-TEX-N-5B\"></use></g><g data-mml-node=\"mi\" transform=\"translate(278,0)\"><use data-c=\"46\" xlink:href=\"#MJX-TEX-N-46\"></use><use data-c=\"65\" xlink:href=\"#MJX-TEX-N-65\" transform=\"translate(653,0)\"></use></g><g data-mml-node=\"mo\" transform=\"translate(1375,0)\"><use data-c=\"28\" xlink:href=\"#MJX-TEX-N-28\"></use></g><g data-mml-node=\"mi\" transform=\"translate(1764,0)\"><use data-c=\"43\" xlink:href=\"#MJX-TEX-N-43\"></use><use data-c=\"4E\" xlink:href=\"#MJX-TEX-N-4E\" transform=\"translate(722,0)\"></use></g><g data-mml-node=\"msub\" transform=\"translate(3236,0)\"><g data-mml-node=\"mo\"><use data-c=\"29\" xlink:href=\"#MJX-TEX-N-29\"></use></g><g data-mml-node=\"mn\" transform=\"translate(422,-150) scale(0.707)\"><use data-c=\"36\" xlink:href=\"#MJX-TEX-N-36\"></use></g></g><g data-mml-node=\"msub\" transform=\"translate(4061.6,0)\"><g data-mml-node=\"mo\"><use data-c=\"5D\" xlink:href=\"#MJX-TEX-N-5D\"></use></g><g data-mml-node=\"mn\" transform=\"translate(311,-150) scale(0.707)\"><use data-c=\"33\" xlink:href=\"#MJX-TEX-N-33\"></use></g></g></g></g></g></svg></mjx-container>. In this formula, the iron within the square brackets, <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.566ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"12.05ex\" height=\"2.47ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -841.7 5326.2 1091.7\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mo\"><use data-c=\"5B\" xlink:href=\"#MJX-TEX-N-5B\"></use></g><g data-mml-node=\"mi\" transform=\"translate(278,0)\"><use data-c=\"46\" xlink:href=\"#MJX-TEX-N-46\"></use><use data-c=\"65\" xlink:href=\"#MJX-TEX-N-65\" transform=\"translate(653,0)\"></use></g><g data-mml-node=\"mo\" transform=\"translate(1375,0)\"><use data-c=\"28\" xlink:href=\"#MJX-TEX-N-28\"></use></g><g data-mml-node=\"mi\" transform=\"translate(1764,0)\"><use data-c=\"43\" xlink:href=\"#MJX-TEX-N-43\"></use><use data-c=\"4E\" xlink:href=\"#MJX-TEX-N-4E\" transform=\"translate(722,0)\"></use></g><g data-mml-node=\"msub\" transform=\"translate(3236,0)\"><g data-mml-node=\"mo\"><use data-c=\"29\" xlink:href=\"#MJX-TEX-N-29\"></use></g><g data-mml-node=\"mn\" transform=\"translate(422,-150) scale(0.707)\"><use data-c=\"36\" xlink:href=\"#MJX-TEX-N-36\"></use></g></g><g data-mml-node=\"msup\" transform=\"translate(4061.6,0)\"><g data-mml-node=\"mo\"><use data-c=\"5D\" xlink:href=\"#MJX-TEX-N-5D\"></use></g><g data-mml-node=\"TeXAtom\" transform=\"translate(311,363) scale(0.707)\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mn\"><use data-c=\"34\" xlink:href=\"#MJX-TEX-N-34\"></use></g><g data-mml-node=\"mo\" transform=\"translate(500,0)\"><use data-c=\"2212\" xlink:href=\"#MJX-TEX-N-2212\"></use></g></g></g></g></g></g></svg></mjx-container>, is in the +2 oxidation state (ferrocyanide ion), while the iron outside the square brackets is in the +3 oxidation state (ferric ion). The compound is a complex salt that arises from the reaction of ferric and ferrous ions with cyanide ions. Therefore, Statement II is also true.</p>\n\n<p>With both statements being true, the correct answer is:</p>\n\n<p>Option A : Statement I is false but Statement II is true.</p>"}]}