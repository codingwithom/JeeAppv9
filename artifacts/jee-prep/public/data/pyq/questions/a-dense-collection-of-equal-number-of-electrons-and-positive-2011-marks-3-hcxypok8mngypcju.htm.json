/2000/svg\" width=\"1.76ex\" height=\"0.968ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -483 778 428\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"mo\"><use data-c=\"2248\" xlink:href=\"#MJX-TEX-N-2248\"></use></g></g></g></svg></mjx-container> 10<sup>- 30</sup>, where these quantities are in proper SI units.</p>","options":[{"identifier":"A","content":"800 nm"},{"identifier":"B","content":"600 nm"},{"identifier":"C","content":"300 nm"},{"identifier":"D","content":"200 nm"}],"correct_options":["B"],"explanation":"<p>For resonance</p>\n<p><mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -1.353ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"16.009ex\" height=\"4.208ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -1262.1 7075.9 1860\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"mi\"><use data-c=\"1D714\" xlink:href=\"#MJX-TEX-I-1D714\"></use></g><g data-mml-node=\"mo\" transform=\"translate(899.8,0)\"><use data-c=\"3D\" xlink:href=\"#MJX-TEX-N-3D\"></use></g><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\" transform=\"translate(1955.6,0)\"><g data-mml-node=\"msub\"><g data-mml-node=\"mi\"><use data-c=\"1D714\" xlink:href=\"#MJX-TEX-I-1D714\"></use></g><g data-mml-node=\"mi\" transform=\"translate(655,-150) scale(0.707)\"><use data-c=\"1D45D\" xlink:href=\"#MJX-TEX-I-1D45D\"></use></g></g></g><g data-mml-node=\"mo\" transform=\"translate(3294,0)\"><use data-c=\"3D\" xlink:href=\"#MJX-TEX-N-3D\"></use></g><g data-mml-node=\"msqrt\" transform=\"translate(4349.8,0)\"><g data-mml-node=\"mo\" transform=\"translate(0,52.1)\"><use data-c=\"221A\" xlink:href=\"#MJX-TEX-LO-221A\"></use></g><g transform=\"translate(1020,0)\"><g data-mml-node=\