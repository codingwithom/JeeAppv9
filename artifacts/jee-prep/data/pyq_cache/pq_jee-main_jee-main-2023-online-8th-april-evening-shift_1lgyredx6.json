3.2,0)\"><use data-c=\"31\" xlink:href=\"#MJX-TEX-N-31\"></use><use data-c=\"32\" xlink:href=\"#MJX-TEX-N-32\" transform=\"translate(500,0)\"></use></g><g data-mml-node=\"mspace\" transform=\"translate(28483.2,0)\"></g><g data-mml-node=\"mi\" transform=\"translate(28650.2,0)\"><use data-c=\"1D707\" xlink:href=\"#MJX-TEX-I-1D707\"></use></g><g data-mml-node=\"mtext\" style=\"font-family: Roboto,'Tiro Devanagari Hindi','Tiro Bangla',sans-serif;\" transform=\"translate(29253.2,0)\"><text data-variant=\"-explicitFont\" transform=\"scale(1,-1)\" font-size=\"884px\">J</text></g><g data-mml-node=\"mo\" transform=\"translate(29853.2,0)\"><use data-c=\"2E\" xlink:href=\"#MJX-TEX-N-2E\"></use></g></g></g></svg></mjx-container></p>\n<p>When the charged capacitor is connected to the uncharged capacitor, the charge will distribute equally between them because they have the same capacitance. Therefore, the final voltage across each capacitor is half of the initial voltage, i.e., 100 V.</p>\n<p>The energy in each capacitor after the redistribution is:</p>\n<p><mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.791ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"72.343ex\" height=\"3.223ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -1074.9 31975.4 1424.4\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"msub\"><g data-mml-node=\"mi\"><use data-c=\"1D448\" xlink:href=\"#MJX-TEX-I-1D448\"></use></g><g data-mml-node=\"TeXAtom\" transform=\"translate(716,-176.7) scale(0.707)\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mtext\" style=\"font-family: Roboto,'Tiro Devanagari Hindi','Tiro Bangla',sans-serif;\"><text data-variant=\"-explicitFont\" transform=\"scale(1,-1)\" font-size=\"884px\">final each</text></g></g></g><g data-mml-node=\"mo\" transform=\"translate(5286.4,0)\"><use data-c=\"3D\" xlink:h