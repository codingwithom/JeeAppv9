;\"><text data-variant=\"-explicitFont\" transform=\"scale(1,-1)\" font-size=\"884px\">Volume of silver nitrate solution</text></g><g data-mml-node=\"mo\" transform=\"translate(20077.8,0)\"><use data-c=\"3D\" xlink:href=\"#MJX-TEX-N-3D\"></use></g><g data-mml-node=\"mfrac\" transform=\"translate(21133.6,0)\"><g data-mml-node=\"mtext\" style=\"font-family: Roboto,'Tiro Devanagari Hindi','Tiro Bangla',sans-serif;\" transform=\"translate(220,481.4) scale(0.707)\"><text data-variant=\"-explicitFont\" transform=\"scale(1,-1)\" font-size=\"884px\">Millimoles of silver nitrate required</text></g><g data-mml-node=\"mtext\" style=\"font-family: Roboto,'Tiro Devanagari Hindi','Tiro Bangla',sans-serif;\" transform=\"translate(644.3,-370.3) scale(0.707)\"><text data-variant=\"-explicitFont\" transform=\"scale(1,-1)\" font-size=\"884px\">Molarity of silver nitrate solution</text></g><rect width=\"15897.8\" height=\"60\" x=\"120\" y=\"220\"></rect></g></g></g></svg></mjx-container>\n<br><br>\nSubstituting the values, we get:\n<br><br>\n<mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -1.158ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"64.528ex\" height=\"3.447ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -1011.8 28521.2 1523.5\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"mtext\" style=\"font-family: Roboto,'Tiro Devanagari Hindi','Tiro Bangla',sans-serif;\"><text data-variant=\"-explicitFont\" transform=\"scale(1,-1)\" font-size=\"884px\">Volume of silver nitrate solution</text></g><g data-mml-node=\"mo\" transform=\"translate(20077.8,0)\"><use data-c=\"3D\" xlink:href=\"#MJX-TEX-N-3D\"></use></g><g data-mml-node=\"mfrac\" transform=\"translate(21133.6,0)\"><g data-mml-node=\"mrow\" transform=\"translate(220,481.4) scale(0.707)\"><g data-mml-node=\"mn\"><use data-c=\"30\" xlink:href=\"#