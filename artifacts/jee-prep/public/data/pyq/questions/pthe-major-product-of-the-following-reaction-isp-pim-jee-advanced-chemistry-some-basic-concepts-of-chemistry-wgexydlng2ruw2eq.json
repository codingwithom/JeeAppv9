074-4b5a-90fc-db98b4390f7e/077661d0-d62b-11ed-a810-4d71dabfb4ba/file-1lg872tf2.png?format=png 750w, https://app-content.cdn.examgoal.net/fly/1000/image/1lg872tf1/cf36844c-9074-4b5a-90fc-db98b4390f7e/077661d0-d62b-11ed-a810-4d71dabfb4ba/file-1lg872tf2.png?format=png 1000w, https://app-content.cdn.examgoal.net/fly/1500/image/1lg872tf1/cf36844c-9074-4b5a-90fc-db98b4390f7e/077661d0-d62b-11ed-a810-4d71dabfb4ba/file-1lg872tf2.png?format=png 1500w, https://app-content.cdn.examgoal.net/fly/2000/image/1lg872tf1/cf36844c-9074-4b5a-90fc-db98b4390f7e/077661d0-d62b-11ed-a810-4d71dabfb4ba/file-1lg872tf2.png?format=png 2000w, https://app-content.cdn.examgoal.net/fly/2500/image/1lg872tf1/cf36844c-9074-4b5a-90fc-db98b4390f7e/077661d0-d62b-11ed-a810-4d71dabfb4ba/file-1lg872tf2.png?format=png 2500w\" sizes=\"(max-width: 767px) 100vw, 720px\" decoding=\"async\">"}],"correct_options":["A"],"explanation":"<p>Alkyl halides undergo nucleophilic substitution more readily than aryl halides due to partial double bond character between aryl carbon and halogen. Hence, substitution occurs more readily in the side chain rather than in the ring. PhS<mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: 0;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"1.432ex\" height=\"1.754ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -775.2 633.1 775.2\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"msup\"><g data-mml-node=\"mi\"></g><g data-mml-node=\"mo\" transform=\"translate(33,363) scale(0.707)\"><use data-c=\"2212\" xlink:href=\"#MJX-TEX-N-2212\"></use></g></g></g></g></svg></mjx-container> is a strong nucleophile and dimethylformamide (DMF) is a highly polar aprotic solvent. Hence, nucleophilic substitution (S<mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.339ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"2.519ex\" height=\"1.846ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -666 1113.3 816\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"msub\"><g data-mml-node=\"mi\"></g><g data-mml-node=\"TeXAtom\" transform=\"translate(33,-150) scale(0.707)\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"4E\" xlink:href=\"#MJX-TEX-N-4E\"></use></g></g></g><g data-mml-node=\"mn\" transform=\"translate(613.3,0)\"><use data-c=\"32\" xlink:href=\"#MJX-TEX-N-32\"></use></g></g></g></svg></mjx-container>) takes place at 2<mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: 0;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"0.988ex\" height=\"1.532ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -677 436.6 677\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"msup\"><g data-mml-node=\"mi\"></g><g data-mml-node=\"mo\" transform=\"translate(33,363) scale(0.707)\"><use data-c=\"2218\" xlink:href=\"#MJX-TEX-N-2218\"></use></g></g></g></g></svg></mjx-container> benzylic carbon. Stereochemically, it involves inversion of configuration at benzylic carbon atom.</p>\n<p><img src=\"https://app-content.cdn.examgoal.net/fly/1000/image/1lg87c96w/4d30c3ab-e61f-4d6d-a00f-ae9d22605c46/0dee0080-d62c-11ed-a810-4d71dabfb4ba/file-1lg87c96x.png?format=png\" data-orsrc=\"https://app-content.cdn.examgoal.net/image/1lg87c96w/4d30c3ab-e61f-4d6d-a00f-ae9d22605c46/0dee0080-d62c-11ed-a810-4d71dabfb4ba/file-1lg87c96x.png\" loading=\"lazy\" style=\"max-width:100%;height:auto;display:block;margin:0px auto;max-height:40vh\" alt=\"IIT-JEE 2008 Paper 1 Offline Chemistry - Haloalkanes and Haloarenes Question 6 English Explanation\" srcset=\"https://app-co