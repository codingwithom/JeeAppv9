vanagari Hindi','Tiro Bangla',sans-serif;\"><text data-variant=\"-explicitFont\" transform=\"scale(1,-1)\" font-size=\"884px\">I</text></g><g data-mml-node=\"TeXAtom\" transform=\"translate(633,477.1) scale(0.707)\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mo\"><use data-c=\"2212\" xlink:href=\"#MJX-TEX-N-2212\"></use></g></g></g><g data-mml-node=\"mspace\" transform=\"translate(6342.3,0)\"></g><g data-mml-node=\"mo\" transform=\"translate(6898,0)\"><use data-c=\"27F6\" xlink:href=\"#MJX-TEX-N-27F6\"></use></g><g data-mml-node=\"mspace\" transform=\"translate(8536,0)\"></g><g data-mml-node=\"mn\" transform=\"translate(9091.8,0)\"><use data-c=\"32\" xlink:href=\"#MJX-TEX-N-32\"></use></g><g data-mml-node=\"mspace\" transform=\"translate(9591.8,0)\"></g><g data-mml-node=\"mtext\" style=\"font-family: Roboto,'Tiro Devanagari Hindi','Tiro Bangla',sans-serif;\" transform=\"translate(9758.8,0)\"><text data-variant=\"-explicitFont\" transform=\"scale(1,-1)\" font-size=\"884px\">CuI</text></g><g data-mml-node=\"mspace\" transform=\"translate(11558.8,0)\"></g><g data-mml-node=\"mo\" transform=\"translate(11669.6,0)\"><use data-c=\"2193\" xlink:href=\"#MJX-TEX-N-2193\"></use></g><g data-mml-node=\"mo\" transform=\"translate(12447.4,0)\"><use data-c=\"2B\" xlink:href=\"#MJX-TEX-N-2B\"></use></g><g data-mml-node=\"msub\" transform=\"translate(13225.4,0)\"><g data-mml-node=\"mtext\" style=\"font-family: Roboto,'Tiro Devanagari Hindi','Tiro Bangla',sans-serif;\"><text data-variant=\"-explicitFont\" transform=\"scale(1,-1)\" font-size=\"884px\">I</text></g><g data-mml-node=\"TeXAtom\" transform=\"translate(633,-235.4) scale(0.707)\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mn\"><use data-c=\"32\" xlink:href=\"#MJX-TEX-N-32\"></use></g></g></g></g></g></svg></mjx-container></p>\n<p>So, the correct answer is:</p>\n<p><strong>Option C: CuI</strong>.</p>"},"hi":{"direction":null,"content":"Cu<sup>2+</sup> नमक पोटैशियम आयोडाइड के साथ प्रतिक्रिया करके देता है","options":[{"ident