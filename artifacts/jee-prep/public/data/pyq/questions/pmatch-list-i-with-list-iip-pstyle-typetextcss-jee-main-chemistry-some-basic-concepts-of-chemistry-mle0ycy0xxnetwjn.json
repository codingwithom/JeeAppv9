{"questions":[{"question_id":"luxzq6ft","content":"<p>Match List I with List II</p>\n<p>\n<table class=\"tg\" style=\"undefined;table-layout: fixed; width: 572px\">\n<colgroup>\n<col style=\"width: 75px\">\n<col style=\"width: 160px\">\n<col style=\"width: 75px\">\n<col style=\"width: 262px\">\n</colgroup>\n<thead>\n  <tr>\n    <th class=\"tg-7btt\"></th>\n    <th class=\"tg-7btt\">LIST I<br>(Cell)</th>\n    <th class=\"tg-7btt\"></th>\n    <th class=\"tg-7btt\">LIST II<br>(Use/Property/Reaction)</th>\n  </tr>\n</thead>\n<tbody>\n  <tr>\n    <td class=\"tg-c3ow\">A.</td>\n    <td class=\"tg-0pky\">Leclanche cell</td>\n    <td class=\"tg-c3ow\">I.</td>\n    <td class=\"tg-0pky\">Converts energy of combustion into electrical energy</td>\n  </tr>\n  <tr>\n    <td class=\"tg-c3ow\">B.\t</td>\n    <td class=\"tg-0pky\">Ni - Cd cell</td>\n    <td class=\"tg-c3ow\">II.</td>\n    <td class=\"tg-0pky\">Does not involve any ion in solution and is used in hearing aids</td>\n  </tr>\n  <tr>\n    <td class=\"tg-c3ow\">C.</td>\n    <td class=\"tg-0pky\">Fuel cell</td>\n    <td class=\"tg-c3ow\">III.</td>\n    <td class=\"tg-0pky\">Rechargeable</td>\n  </tr>\n  <tr>\n    <td class=\"tg-c3ow\">D.</td>\n    <td class=\"tg-0pky\">Mercury cell</td>\n    <td class=\"tg-c3ow\">IV.</td>\n    <td class=\"tg-0pky\">Reaction at anode <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.186ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"17.366ex\" height=\"2.179ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -881 7675.8 963\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"5A\" xlink:href=\"#MJX-TEX-N-5A\"></use><use data-c=\"6E\" xlink:href=\"#MJX-TEX-N-6E\" transform=\"translate(611,0)\"></use></g></g><g data-mml-node=\"mo\" transfor