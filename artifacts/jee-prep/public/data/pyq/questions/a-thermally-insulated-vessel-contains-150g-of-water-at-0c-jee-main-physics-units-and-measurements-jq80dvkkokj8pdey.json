          "identifier": "A",
          "content": "35 g"
        },
        {
          "identifier": "B",
          "content": "130 g"
        },
        {
          "identifier": "C",
          "content": "20 g"
        },
        {
          "identifier": "D",
          "content": "150 g"
        }
      ],
      "correct_options": [
