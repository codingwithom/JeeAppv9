nk:href=\"#MJX-TEX-I-1D454\"></use></g><g data-mml-node=\"mn\" transform=\"translate(563.2,363) scale(0.707)\"><use data-c=\"32\" xlink:href=\"#MJX-TEX-N-32\"></use></g></g></g><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\" transform=\"translate(6138.6,0)\"><g data-mml-node=\"msup\"><g data-mml-node=\"mi\"><use data-c=\"1D461\" xlink:href=\"#MJX-TEX-I-1D461\"></use></g><g data-mml-node=\"mn\" transform=\"translate(394,363) scale(0.707)\"><use data-c=\"32\" xlink:href=\"#MJX-TEX-N-32\"></use></g></g></g></g></g></svg></mjx-container></p>\n<p><mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.054ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"9.724ex\" height=\"1.941ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -833.9 4297.9 857.9\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"mo\"><use data-c=\"21D2\" xlink:href=\"#MJX-TEX-N-21D2\"></use></g><g data-mml-node=\"mi\" transform=\"translate(1277.8,0)\"><use data-c=\"1D43E\" xlink:href=\"#MJX-TEX-I-1D43E\"></use></g><g data-mml-node=\"mo\" transform=\"translate(2444.6,0)\"><use data-c=\"221D\" xlink:href=\"#MJX-TEX-N-221D\"></use></g><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\" transform=\"translate(3500.3,0)\"><g data-mml-node=\"msup\"><g data-mml-node=\"mi\"><use data-c=\"1D461\" xlink:href=\"#MJX-TEX-I-1D461\"></use></g><g data-mml-node=\"mn\" transform=\"translate(394,363) scale(0.707)\"><use data-c=\"32\" xlink:href=\"#MJX-TEX-N-32\"></use></g></g></g></g></g></svg></mjx-container> (As m and g are constant)</p>\n<p>This shows that relation between kinetic energy of tennis ball K and time t is parabolic.</p>\n<p>During the collision, velocity of the ball falls sharply to zero as it is compressed and regains maximum velocity in the same short time interval.</p>\n<p>This relation is best illustrated by the option (b).</p>"}]}