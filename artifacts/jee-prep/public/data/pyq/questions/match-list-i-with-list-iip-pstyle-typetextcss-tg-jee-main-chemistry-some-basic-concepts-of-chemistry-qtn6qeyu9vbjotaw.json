t\"></th>\n    <th class=\"tg-7btt\">LIST II<br>(Properties in their respective groups)</th>\n  </tr>\n</thead>\n<tbody>\n  <tr>\n    <td class=\"tg-c3ow\">A.</td>\n    <td class=\"tg-0pky\"><mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.439ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"4.526ex\" height=\"2.034ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -705 2000.7 899\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"43\" xlink:href=\"#MJX-TEX-N-43\"></use><use data-c=\"6C\" xlink:href=\"#MJX-TEX-N-6C\" transform=\"translate(722,0)\"></use></g><g data-mml-node=\"mo\" transform=\"translate(1000,0)\"><use data-c=\"2C\" xlink:href=\"#MJX-TEX-N-2C\"></use></g><g data-mml-node=\"mi\" transform=\"translate(1444.7,0)\"><use data-c=\"53\" xlink:href=\"#MJX-TEX-N-53\"></use></g></g></g></g></svg></mjx-container></td>\n    <td class=\"tg-c3ow\">I.</td>\n    <td class=\"tg-0pky\">Elements with highest electronegativity </td>\n  </tr>\n  <tr>\n    <td class=\"tg-c3ow\">B.\t</td>\n    <td class=\"tg-0pky\"><mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.439ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"6.375ex\" height=\"2.059ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -716 2817.7 910\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"47\" xlink:href=\"#MJX-TEX-N-47\"></use><use data-c=\"65\" xlink:href=\"#MJX-TEX-N-65\" transform=\"translate(785,0)\"></use></g><g data-mml-node=\"mo\" transform=\"translate(1229,0)\"><use data-c=\"2C\" xlink:href=\"#MJX-TEX-N-2C\"></use></g><g data-mml-node=\"mi\" transform=\"translate(1673.7,0)\"><use data-c=\"41\" xlink:href=\"#MJX-TEX-N-41\"></use><use data-c=\"73\" xlink:href=\"#MJX-TEX-N-73\" transform=\"translate(750,0)\"></use></g></g></g></g></svg></mjx-container></td>\n    <td class=\"tg-c3ow\">II.</td>\n    <td class=\"tg-0pky\">Elements with largest atomic size</td>\n  </tr>\n  <tr>\n    <td class=\"tg-c3ow\">C.</td>\n    <td class=\"tg-0pky\"><mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.439ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"6.167ex\" height=\"1.984ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -683 2725.7 877\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"46\" xlink:href=\"#MJX-TEX-N-46\"></use><use data-c=\"72\" xlink:href=\"#MJX-TEX-N-72\" transform=\"translate(653,0)\"></use></g><g data-mml-node=\"mo\" transform=\"translate(1045,0)\"><use data-c=\"2C\" xlink:href=\"#MJX-TEX-N-2C\"></use></g><g data-mml-node=\"mi\" transform=\"translate(1489.7,0)\"><use data-c=\"52\" xlink:href=\"#MJX-TEX-N-52\"></use><use data-c=\"61\" xlink:href=\"#MJX-TEX-N-61\" transform=\"translate(736,0)\"></use></g></g></g></g></svg></mjx-container></td>\n    <td class=\"tg-c3ow\">III.</td>\n    <td class=\"tg-0pky\">Elements which show properties of both metals and non-metal</td>\n  </tr>\n  <tr>\n    <td class=\"tg-c3ow\">D.</td>\n    <td class=\"tg-0pky\"><mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.439ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"4.244ex\" height=\"2.034ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -705 1875.7 899\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"46\" xlink:href=\"#MJX-TEX-N-46\"></use></g><g data-mml-node=\"mo\" transform=\"translate(653,0)\"><use data-c=\"2C\" xlink:href=\"#MJX-TEX-N-2C\"></use></g><g data-mml-node=\"mi\" transform=\"translate(1097.7,0)\"><use data-c=\"4F\" xlink:href=\"#MJX-TEX-N-4F\"></use></g></g></g></g></svg></mjx-container></td>\n    <td class=\"tg-c3ow\">IV.</td>\n    <td class=\"tg-0pky\">Elements with highest negative electron gain enthalpy</td>\n  </tr>\n</tbody>\n</table></p>\n<p>Choose the correct answer from the options given below:</p>","options":[{"identifier":"A","content":"A-III, B-II, C-I, D-IV\n"},{"identifier":"B","content":"A-II, B-I, C-IV, D-III\n"},{"identifier":"C","content":"A-II, B-III, C-IV, D-I\n"},{"identifier":"D","content":"A-IV, B-III, C-II, D-I"}],"correct_options":["D"],"answer":null,"explanation":"<p>To match the elements from List I with their corresponding properties in List II, let's analyze each pair:</p>\n\n<p>A. <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.439ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"4.526ex\" height=\"2.034ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -705 2000.7 899\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"43\" xlink:href=\"#MJX-TEX-N-43\"></use><use data-c=\"6C\" xlink:href=\"#MJX-TEX-N-6C\" transform=\"translate(722,0)\"></use></g><g data-mml-node=\"mo\" transform=\"translate(1000,0)\"><use data-c=\"2C\" xlink:href=\"#MJX-TEX-N-2C\"></use></g><g data-mml-node=\"mi\" transform=\"translate(1444.7,0)\"><use data-c=\"53\" xlink:href=\"#MJX-TEX-N-53\"></use></g></g></g></g></svg></mjx-container><br>\n\n<p>These elements are known for having high negative electron gain enthalpy (energy released when an electron is added to an atom). Chlorine (<mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.048ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"2.262ex\" height=\"1.643ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -705 1000 726\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"43\" xlink:href=\"#MJX-TEX-N-43\"></use><use data-c=\"6C\" xlink:href=\"#MJX-TEX-N-6C\" transform=\"translate(722,0)\"></use></g></g></g></g></svg></mjx-container>) and sulfur (<mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.05ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"1.258ex\" height=\"1.645ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -705 556 727\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"53\" xlink:href=\"#MJX-TEX-N-53\"></use></g></g></g></g></svg></mjx-container>) are both elements that release a significant amount of energy when they gain an electron.<br></p>\n\n<p>Hence, they match with IV: Elements with highest negative electron gain enthalpy.</p></p>\n\n<p>B. <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.439ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"6.375ex\" height=\"2.059ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -716 2817.7 910\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"47\" xlink:href=\"#MJX-TEX-N-47\"></use><use data-c=\"65\" xlink:href=\"#MJX-TEX-N-65\" transform=\"translate(785,0)\"></use></g><g data-mml-node=\"mo\" transform=\"translate(1229,0)\"><use data-c=\"2C\" xlink:href=\"#MJX-TEX-N-2C\"></use></g><g data-mml-node=\"mi\" transform=\"translate(1673.7,0)\"><use data-c=\"41\" xlink:href=\"#MJX-TEX-N-41\"></use><use data-c=\"73\" xlink:href=\"#MJX-TEX-N-73\" transform=\"translate(750,0)\"></use></g></g></g></g></svg></mjx-container><br>\n\n<p>Germanium (<mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.05ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"2.781ex\" height=\"1.645ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -705 1229 727\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"47\" xlink:href=\"#MJX-TEX-N-47\"></use><use data-c=\"65\" xlink:href=\"#MJX-TEX-N-65\" transform=\"translate(785,0)\"></use></g></g></g></g></svg></mjx-container>) and arsenic (<mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.025ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"2.588ex\" height=\"1.645ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -716 1144 727\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"41\" xlink:href=\"#MJX-TEX-N-41\"></use><use data-c=\"73\" xlink:href=\"#MJX-TEX-N-73\" transform=\"translate(750,0)\"></use></g></g></g></g></svg></mjx-container>) are metalloids, meaning they show properties of both metals and non-metals.<br></p>\n\n<p>Hence, they match with III: Elements which show properties of both metals and non-metal.</p></p>\n\n<p>C. <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.439ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"6.167ex\" height=\"1.984ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -683 2725.7 877\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"46\" xlink:href=\"#MJX-TEX-N-46\"></use><use data-c=\"72\" xlink:href=\"#MJX-TEX-N-72\" transform=\"translate(653,0)\"></use></g><g data-mml-node=\"mo\" transform=\"translate(1045,0)\"><use data-c=\"2C\" xlink:href=\"#MJX-TEX-N-2C\"></use></g><g data-mml-node=\"mi\" transform=\"translate(1489.7,0)\"><use data-c=\"52\" xlink:href=\"#MJX-TEX-N-52\"></use><use data-c=\"61\" xlink:href=\"#MJX-TEX-N-61\" transform=\"translate(736,0)\"></use></g></g></g></g></svg></mjx-container><br>\n\n<p>Francium (<mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: 0;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"2.364ex\" height=\"1.538ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -680 1045 680\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"46\" xlink:href=\"#MJX-TEX-N-46\"></use><use data-c=\"72\" xlink:href=\"#MJX-TEX-N-72\" transform=\"translate(653,0)\"></use></g></g></g></g></svg></mjx-container>) and radium (<mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.05ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"2.796ex\" height=\"1.595ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -683 1236 705\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"52\" xlink:href=\"#MJX-TEX-N-52\"></use><use data-c=\"61\" xlink:href=\"#MJX-TEX-N-61\" transform=\"translate(736,0)\"></use></g></g></g></g></svg></mjx-container>) are elements that have very large atomic sizes, being at the bottom of their respective groups on the periodic table.<br></p>\n\n<p>Hence, they match with II: Elements with largest atomic size.</p></p>\n\n<p>D. <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.439ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"4.244ex\" height=\"2.034ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -705 1875.7 899\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"46\" xlink:href=\"#MJX-TEX-N-46\"></use></g><g data-mml-node=\"mo\" transform=\"translate(653,0)\"><use data-c=\"2C\" xlink:href=\"#MJX-TEX-N-2C\"></use></g><g data-mml-node=\"mi\" transform=\"translate(1097.7,0)\"><use data-c=\"4F\" xlink:href=\"#MJX-TEX-N-4F\"></use></g></g></g></g></svg></mjx-container><br>\n\n<p>Fluorine (<mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: 0;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"1.477ex\" height=\"1.538ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -680 653 680\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"46\" xlink:href=\"#MJX-TEX-N-46\"></use></g></g></g></g></svg></mjx-container>) and oxygen (<mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.05ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"1.76ex\" height=\"1.645ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -705 778 727\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"4F\" xlink:href=\"#MJX-TEX-N-4F\"></use></g></g></g></g></svg></mjx-container>) are elements with the highest electronegativity, meaning they strongly attract electrons toward themselves.<br></p>\n\n<p>Hence, they match with I: Elements with highest electronegativity.</p></p>\n\n<p>Summarizing, we have:</p>\n\n<p>A-IV, B-III, C-II, D-I</p>\n\n<p>The correct option is:</p>\n\n<p>Option D<br>\n\n<p>A-IV, B-III, C-II, D-I</p></p>"},"hi":{"direction":null,"comprehension":null,"content":"<p>सूची I का मिलान सूची II से करें:</p>\n<p>\n<table class=\"tg\" style=\"undefined;table-layout: fixed; width: 673px\"><colgroup>\n<col style=\"width: 78px\">\n<col style=\"width: 261px\">\n<col style=\"width: 83px\">\n<col style=\"width: 251px\">\n</colgroup>\n<thead>\n  <tr>\n    <th class=\"tg-7btt\"></th>\n    <th class=\"tg-7btt\">सूची I<br>(तत्व)</th>\n    <th class=\"tg-7btt\"></th>\n    <th class=\"tg-7btt\">सूची II<br>(संगत समूहों में उनके गुण)</th>\n  </tr></thead>\n<tbody>\n  <tr>\n    <td class=\"tg-c3ow\">(A)</td>\n    <td class=\"tg-0pky\">Cl, S</td>\n    <td class=\"tg-c3ow\">(I)</td>\n    <td class=\"tg-0pky\">उच्चतम विद्युत ऋणात्मक वाले तत्व</td>\n  </tr>\n  <tr>\n    <td class=\"tg-c3ow\">(B)</td>\n    <td class=\"tg-0pky\">Ge, As</td>\n    <td class=\"tg-c3ow\">(II)</td>\n    <td class=\"tg-0pky\">अधिकतम परमाणु त्रिज्या वाले तत्व</td>\n  </tr>\n  <tr>\n    <td class=\"tg-c3ow\">(C)</td>\n    <td class=\"tg-0pky\">Fr, Ra</td>\n    <td class=\"tg-c3ow\">(III)</td>\n    <td class=\"tg-0pky\">धातु एवं अधातु तत्वों के गुणधर्मों वाले तत्व</td>\n  </tr>\n  <tr>\n    <td class=\"tg-c3ow\">(D)</td>\n    <td class=\"tg-0pky\">F, O</td>\n    <td class=\"tg-c3ow\">(IV)</td>\n    <td class=\"tg-0pky\">सर्वाधिक ऋणात्मक इलेक्ट्रॉन लब्धि एन्थैल्पी वाले तत्व</td>\n  </tr>\n</tbody>\n</table></p>\n<p>नीचे दिए गए विकल्पों में से सही उत्तर चुनें:</p>","options":[{"identifier":"A","content":"A-III, B-II, C-I, D-IV\n"},{"identifier":"B","content":"A-II, B-I, C-IV, D-III\n"},{"identifier":"C","content":"A-II, B-III, C-IV, D-I\n"},{"identifier":"D","content":"A-IV, B-III, C-II, D-I"}],"correct_options":["D"],"answer":null,"explanation":"<p>सूची I के तत्वों को सूची II में उनके संबंधित गुणों के साथ मिलान करने के लिए, आइए प्रत्येक युग्म का विश्लेषण करें:</p>\n\n<p>A. <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.439ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"4.526ex\" height=\"2.034ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -705 2000.7 899\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"43\" xlink:href=\"#MJX-TEX-N-43\"></use><use data-c=\"6C\" xlink:href=\"#MJX-TEX-N-6C\" transform=\"translate(722,0)\"></use></g><g data-mml-node=\"mo\" transform=\"translate(1000,0)\"><use data-c=\"2C\" xlink:href=\"#MJX-TEX-N-2C\"></use></g><g data-mml-node=\"mi\" transform=\"translate(1444.7,0)\"><use data-c=\"53\" xlink:href=\"#MJX-TEX-N-53\"></use></g></g></g></g></svg></mjx-container><br>\n\n<p>ये तत्व उच्च ऋणात्मक इलेक्ट्रॉन लब्धि एन्थैल्पी (जब किसी परमाणु में इलेक्ट्रॉन जोड़ा जाता है तो मुक्त होने वाली ऊर्जा) के लिए जाने जाते हैं। क्लोरीन (<mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.048ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"2.262ex\" height=\"1.643ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -705 1000 726\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"43\" xlink:href=\"#MJX-TEX-N-43\"></use><use data-c=\"6C\" xlink:href=\"#MJX-TEX-N-6C\" transform=\"translate(722,0)\"></use></g></g></g></g></svg></mjx-container>) और सल्फर (<mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.05ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"1.258ex\" height=\"1.645ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -705 556 727\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"53\" xlink:href=\"#MJX-TEX-N-53\"></use></g></g></g></g></svg></mjx-container>) दोनों ऐसे तत्व हैं जो इलेक्ट्रॉन प्राप्त करने पर महत्वपूर्ण मात्रा में ऊर्जा मुक्त करते हैं।<br></p>\n\n<p>अतः, ये IV: उच्चतम ऋणात्मक इलेक्ट्रॉन लब्धि एन्थैल्पी वाले तत्व के साथ मेल खाते हैं।</p></p>\n\n<p>B. <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.439ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"6.375ex\" height=\"2.059ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -716 2817.7 910\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"47\" xlink:href=\"#MJX-TEX-N-47\"></use><use data-c=\"65\" xlink:href=\"#MJX-TEX-N-65\" transform=\"translate(785,0)\"></use></g><g data-mml-node=\"mo\" transform=\"translate(1229,0)\"><use data-c=\"2C\" xlink:href=\"#MJX-TEX-N-2C\"></use></g><g data-mml-node=\"mi\" transform=\"translate(1673.7,0)\"><use data-c=\"41\" xlink:href=\"#MJX-TEX-N-41\"></use><use data-c=\"73\" xlink:href=\"#MJX-TEX-N-73\" transform=\"translate(750,0)\"></use></g></g></g></g></svg></mjx-container><br>\n\n<p>जर्मेनियम (<mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.05ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"2.781ex\" height=\"1.645ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -705 1229 727\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"47\" xlink:href=\"#MJX-TEX-N-47\"></use><use data-c=\"65\" xlink:href=\"#MJX-TEX-N-65\" transform=\"translate(785,0)\"></use></g></g></g></g></svg></mjx-container>) और आर्सेनिक (<mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.025ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"2.588ex\" height=\"1.645ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -716 1144 727\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"41\" xlink:href=\"#MJX-TEX-N-41\"></use><use data-c=\"73\" xlink:href=\"#MJX-TEX-N-73\" transform=\"translate(750,0)\"></use></g></g></g></g></svg></mjx-container>) उपधातु हैं, अर्थात् वे धातुओं और अधातुओं दोनों के गुण प्रदर्शित करते हैं।<br></p>\n\n<p>अतः, ये III: वे तत्व जो धातुओं और अधातुओं दोनों के गुण प्रदर्शित करते हैं के साथ मेल खाते हैं।</p></p>\n\n<p>C. <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.439ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"6.167ex\" height=\"1.984ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -683 2725.7 877\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"46\" xlink:href=\"#MJX-TEX-N-46\"></use><use data-c=\"72\" xlink:href=\"#MJX-TEX-N-72\" transform=\"translate(653,0)\"></use></g><g data-mml-node=\"mo\" transform=\"translate(1045,0)\"><use data-c=\"2C\" xlink:href=\"#MJX-TEX-N-2C\"></use></g><g data-mml-node=\"mi\" transform=\"translate(1489.7,0)\"><use data-c=\"52\" xlink:href=\"#MJX-TEX-N-52\"></use><use data-c=\"61\" xlink:href=\"#MJX-TEX-N-61\" transform=\"translate(736,0)\"></use></g></g></g></g></svg></mjx-container><br>\n\n<p>फ्रांसियम (<mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: 0;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"2.364ex\" height=\"1.538ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -680 1045 680\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"46\" xlink:href=\"#MJX-TEX-N-46\"></use><use data-c=\"72\" xlink:href=\"#MJX-TEX-N-72\" transform=\"translate(653,0)\"></use></g></g></g></g></svg></mjx-container>) और रेडियम (<mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.05ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"2.796ex\" height=\"1.595ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -683 1236 705\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"52\" xlink:href=\"#MJX-TEX-N-52\"></use><use data-c=\"61\" xlink:href=\"#MJX-TEX-N-61\" transform=\"translate(736,0)\"></use></g></g></g></g></svg></mjx-container>) ऐसे तत्व हैं जिनका परमाणु आकार बहुत बड़ा होता है, क्योंकि ये आवर्त सारणी में अपने संबंधित समूहों के सबसे नीचे स्थित हैं।<br></p>\n\n<p>अतः, ये II: सबसे बड़े परमाणु आकार वाले तत्व के साथ मेल खाते हैं।</p></p>\n\n<p>D. <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.439ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"4.244ex\" height=\"2.034ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -705 1875.7 899\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"46\" xlink:href=\"#MJX-TEX-N-46\"></use></g><g data-mml-node=\"mo\" transform=\"translate(653,0)\"><use data-c=\"2C\" xlink:href=\"#MJX-TEX-N-2C\"></use></g><g data-mml-node=\"mi\" transform=\"translate(1097.7,0)\"><use data-c=\"4F\" xlink:href=\"#MJX-TEX-N-4F\"></use></g></g></g></g></svg></mjx-container><br>\n\n<p>फ्लोरीन (<mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: 0;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"1.477ex\" height=\"1.538ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -680 653 680\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"46\" xlink:href=\"#MJX-TEX-N-46\"></use></g></g></g></g></svg></mjx-container>) और ऑक्सीजन (<mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.05ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"1.76ex\" height=\"1.645ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -705 778 727\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"4F\" xlink:href=\"#MJX-TEX-N-4F\"></use></g></g></g></g></svg></mjx-container>) उच्चतम विद्युतऋणात्मकता वाले तत्व हैं, अर्थात् वे इलेक्ट्रॉनों को अपनी ओर दृढ़ता से आकर्षित करते हैं।<br></p>\n\n<p>अतः, ये I: उच्चतम विद्युतऋणात्मकता वाले तत्व के साथ मेल खाते हैं।</p></p>\n\n<p>सारांश में, हमारे पास है:</p>\n\n<p>A-IV, B-III, C-II, D-I</p>\n\n<p>सही विकल्प है:</p>\n\n<p>विकल्प D<br>\n\n<p>A-IV, B-III, C-II, D-I</p></p>"}},"subject":"chemistry","subjectGroup":null,"timeAllotted":120000,"topic":"periodic-table-and-its-features","type":"mcq","year":2024,"isOutOfSyllabus":false,"isBonus":false,"tags":["matching_table"],"yearKey":"jee-main-2024-online-8th-april-morning-shift","active":true,"options":[{"identifier":"A","content":"A-III, B-II, C-I, D-IV\n"},{"identifier":"B","content":"A-II, B-I, C-IV, D-III\n"},{"identifier":"C","content":"A-II, B-III, C-IV, D-I\n"},{"identifier":"D","content":"A-IV, B-III, C-II, D-I"}],"correct_options":["D"],"explanation":"<p>To match the elements from List I with their corresponding properties in List II, let's analyze each pair:</p>\n\n<p>A. <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.439ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"4.526ex\" height=\"2.034ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -705 2000.7 899\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"43\" xlink:href=\"#MJX-TEX-N-43\"></use><use data-c=\"6C\" xlink:href=\"#MJX-TEX-N-6C\" transform=\"translate(722,0)\"></use></g><g data-mml-node=\"mo\" transform=\"translate(1000,0)\"><use data-c=\"2C\" xlink:href=\"#MJX-TEX-N-2C\"></use></g><g data-mml-node=\"mi\" transform=\"translate(1444.7,0)\"><use data-c=\"53\" xlink:href=\"#MJX-TEX-N-53\"></use></g></g></g></g></svg></mjx-container><br>\n\n<p>These elements are known for having high negative electron gain enthalpy (energy released when an electron is added to an atom). Chlorine (<mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.048ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"2.262ex\" height=\"1.643ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -705 1000 726\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"43\" xlink:href=\"#MJX-TEX-N-43\"></use><use data-c=\"6C\" xlink:href=\"#MJX-TEX-N-6C\" transform=\"translate(722,0)\"></use></g></g></g></g></svg></mjx-container>) and sulfur (<mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.05ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"1.258ex\" height=\"1.645ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -705 556 727\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"53\" xlink:href=\"#MJX-TEX-N-53\"></use></g></g></g></g></svg></mjx-container>) are both elements that release a significant amount of energy when they gain an electron.<br></p>\n\n<p>Hence, they match with IV: Elements with highest negative electron gain enthalpy.</p></p>\n\n<p>B. <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.439ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"6.375ex\" height=\"2.059ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -716 2817.7 910\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"47\" xlink:href=\"#MJX-TEX-N-47\"></use><use data-c=\"65\" xlink:href=\"#MJX-TEX-N-65\" transform=\"translate(785,0)\"></use></g><g data-mml-node=\"mo\" transform=\"translate(1229,0)\"><use data-c=\"2C\" xlink:href=\"#MJX-TEX-N-2C\"></use></g><g data-mml-node=\"mi\" transform=\"translate(1673.7,0)\"><use data-c=\"41\" xlink:href=\"#MJX-TEX-N-41\"></use><use data-c=\"73\" xlink:href=\"#MJX-TEX-N-73\" transform=\"translate(750,0)\"></use></g></g></g></g></svg></mjx-container><br>\n\n<p>Germanium (<mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.05ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"2.781ex\" height=\"1.645ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -705 1229 727\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"47\" xlink:href=\"#MJX-TEX-N-47\"></use><use data-c=\"65\" xlink:href=\"#MJX-TEX-N-65\" transform=\"translate(785,0)\"></use></g></g></g></g></svg></mjx-container>) and arsenic (<mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.025ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"2.588ex\" height=\"1.645ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -716 1144 727\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"41\" xlink:href=\"#MJX-TEX-N-41\"></use><use data-c=\"73\" xlink:href=\"#MJX-TEX-N-73\" transform=\"translate(750,0)\"></use></g></g></g></g></svg></mjx-container>) are metalloids, meaning they show properties of both metals and non-metals.<br></p>\n\n<p>Hence, they match with III: Elements which show properties of both metals and non-metal.</p></p>\n\n<p>C. <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.439ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"6.167ex\" height=\"1.984ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -683 2725.7 877\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"46\" xlink:href=\"#MJX-TEX-N-46\"></use><use data-c=\"72\" xlink:href=\"#MJX-TEX-N-72\" transform=\"translate(653,0)\"></use></g><g data-mml-node=\"mo\" transform=\"translate(1045,0)\"><use data-c=\"2C\" xlink:href=\"#MJX-TEX-N-2C\"></use></g><g data-mml-node=\"mi\" transform=\"translate(1489.7,0)\"><use data-c=\"52\" xlink:href=\"#MJX-TEX-N-52\"></use><use data-c=\"61\" xlink:href=\"#MJX-TEX-N-61\" transform=\"translate(736,0)\"></use></g></g></g></g></svg></mjx-container><br>\n\n<p>Francium (<mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: 0;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"2.364ex\" height=\"1.538ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -680 1045 680\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"46\" xlink:href=\"#MJX-TEX-N-46\"></use><use data-c=\"72\" xlink:href=\"#MJX-TEX-N-72\" transform=\"translate(653,0)\"></use></g></g></g></g></svg></mjx-container>) and radium (<mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.05ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"2.796ex\" height=\"1.595ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -683 1236 705\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"52\" xlink:href=\"#MJX-TEX-N-52\"></use><use data-c=\"61\" xlink:href=\"#MJX-TEX-N-61\" transform=\"translate(736,0)\"></use></g></g></g></g></svg></mjx-container>) are elements that have very large atomic sizes, being at the bottom of their respective groups on the periodic table.<br></p>\n\n<p>Hence, they match with II: Elements with largest atomic size.</p></p>\n\n<p>D. <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.439ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"4.244ex\" height=\"2.034ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -705 1875.7 899\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"46\" xlink:href=\"#MJX-TEX-N-46\"></use></g><g data-mml-node=\"mo\" transform=\"translate(653,0)\"><use data-c=\"2C\" xlink:href=\"#MJX-TEX-N-2C\"></use></g><g data-mml-node=\"mi\" transform=\"translate(1097.7,0)\"><use data-c=\"4F\" xlink:href=\"#MJX-TEX-N-4F\"></use></g></g></g></g></svg></mjx-container><br>\n\n<p>Fluorine (<mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: 0;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"1.477ex\" height=\"1.538ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -680 653 680\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"46\" xlink:href=\"#MJX-TEX-N-46\"></use></g></g></g></g></svg></mjx-container>) and oxygen (<mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.05ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"1.76ex\" height=\"1.645ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -705 778 727\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"4F\" xlink:href=\"#MJX-TEX-N-4F\"></use></g></g></g></g></svg></mjx-container>) are elements with the highest electronegativity, meaning they strongly attract electrons toward themselves.<br></p>\n\n<p>Hence, they match with I: Elements with highest electronegativity.</p></p>\n\n<p>Summarizing, we have:</p>\n\n<p>A-IV, B-III, C-II, D-I</p>\n\n<p>The correct option is:</p>\n\n<p>Option D<br>\n\n<p>A-IV, B-III, C-II, D-I</p></p>"}]}