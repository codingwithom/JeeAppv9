TEX-N-4D\"></use><use data-c=\"6E\" xlink:href=\"#MJX-TEX-N-6E\" transform=\"translate(917,0)\"></use></g><g data-mml-node=\"TeXAtom\" transform=\"translate(1506,410.1) scale(0.707)\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mn\"><use data-c=\"32\" xlink:href=\"#MJX-TEX-N-32\"></use></g><g data-mml-node=\"mo\" transform=\"translate(500,0)\"><use data-c=\"2B\" xlink:href=\"#MJX-TEX-N-2B\"></use></g></g></g></g><g data-mml-node=\"mo\" transform=\"translate(11943.7,0)\"><use data-c=\"2B\" xlink:href=\"#MJX-TEX-N-2B\"></use></g><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\" transform=\"translate(12944,0)\"><g data-mml-node=\"msub\"><g data-mml-node=\"mi\"><use data-c=\"49\" xlink:href=\"#MJX-TEX-N-49\"></use></g><g data-mml-node=\"mn\" transform=\"translate(394,-150) scale(0.707)\"><use data-c=\"32\" xlink:href=\"#MJX-TEX-N-32\"></use></g></g></g><g data-mml-node=\"mo\" transform=\"translate(13963.7,0)\"><use data-c=\"2B\" xlink:href=\"#MJX-TEX-N-2B\"></use></g><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\" transform=\"translate(14964,0)\"><g data-mml-node=\"msub\"><g data-mml-node=\"mi\"><use data-c=\"48\" xlink:href=\"#MJX-TEX-N-48\"></use></g><g data-mml-node=\"mn\" transform=\"translate(783,-150) scale(0.707)\"><use data-c=\"32\" xlink:href=\"#MJX-TEX-N-32\"></use></g></g><g data-mml-node=\"mi\" transform=\"translate(1186.6,0)\"><use data-c=\"4F\" xlink:href=\"#MJX-TEX-N-4F\"></use></g></g></g></g></svg></mjx-container>\n<br><br>\nIn this reaction, <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.339ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"7.841ex\" height=\"1.934ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -705 3465.6 855\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"msub\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"4B\" xlink:href=\"#MJX-TEX-N-4B\"></use><use data-c=\"4D\" xlink:href=\"#MJX-TEX-N-4D\" transform=\"translate(778,0)\"></use><use data-c=\"6E\" xlink:href=\"#MJX-TEX-N-6E\" transform=\"translate(1695,0)\"></use><use data-c=\"4F\" xlink:href=\"#MJX-TEX-N-4F\" transform=\"translate(2251,0)\"></use></g></g><g data-mml-node=\"mn\" transform=\"translate(3062,-150) scale(0.707)\"><use data-c=\"34\" xlink:href=\"#MJX-TEX-N-34\"></use></g></g></g></g></svg></mjx-container> acts as an oxidizing agent, while <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: 0;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"2.577ex\" height=\"1.545ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -683 1139 683\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"4B\" xlink:href=\"#MJX-TEX-N-4B\"></use><use data-c=\"49\" xlink:href=\"#MJX-TEX-N-49\" transform=\"translate(778,0)\"></use></g></g></g></g></svg></mjx-container> acts as a reducing agent. The oxidation state of manganese changes from +7 in <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.339ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"7.841ex\" height=\"1.934ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -705 3465.6 855\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"msub\"><g data-mml-node=\"mi\"><use data-c=\"4B\" xlink:href=\"#MJX-TEX-N-4B\"></use><use data-c=\"4D\" xlink:href=\"#MJX-TEX-N-4D\" transform=\"translate(778,0)\"></use><use data-c=\"6E\" xlink:href=\"#MJX-TEX-N-6E\" transform=\"translate(1695,0)\"></use><use data-c=\"4F\" xlink:href=\"#MJX-TEX-N-4F\" transform=\"translate(2251,0)\"></use></g><g data-mml-node=\"mn\" transform=\"translate(3062,-150) scale(0.707)\"><use data-c=\"34\" xlink:href=\"#MJX-TEX-N-34\"></use></g></g></g></g></g></svg></mjx-container> to +2 in <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: 0;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"5.565ex\" height=\"1.993ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -881 2459.7 881\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"msup\"><g data-mml-node=\"mi\"><use data-c=\"4D\" xlink:href=\"#MJX-TEX-N-4D\"></use><use data-c=\"6E\" xlink:href=\"#MJX-TEX-N-6E\" transform=\"translate(917,0)\"></use></g><g data-mml-node=\"TeXAtom\" transform=\"translate(1506,410.1) scale(0.707)\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mn\"><use data-c=\"32\" xlink:href=\"#MJX-TEX-N-32\"></use></g><g data-mml-node=\"mo\" transform=\"translate(500,0)\"><use data-c=\"2B\" xlink:href=\"#MJX-TEX-N-2B\"></use></g></g></g></g></g></g></svg></mjx-container>, which is a reduction of 5 units.<br><br> Therefore, the total change in the oxidation state of manganese involved in the reaction is <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.654ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"2.339ex\" height=\"2.765ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -933 1034 1222\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"menclose\"><g transform=\"translate(267, 0)\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mstyle\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass