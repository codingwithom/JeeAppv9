e(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"msubsup\"><g data-mml-node=\"mi\"><use data-c=\"1D43E\" xlink:href=\"#MJX-TEX-I-1D43E\"></use></g><g data-mml-node=\"TeXAtom\" transform=\"translate(974,530.4) scale(0.707)\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mo\"><use data-c=\"28\" xlink:href=\"#MJX-TEX-N-28\"></use></g><g data-mml-node=\"mn\" transform=\"translate(389,0)\"><use data-c=\"32\" xlink:href=\"#MJX-TEX-N-32\"></use></g><g data-mml-node=\"mo\" transform=\"translate(889,0)\"><use data-c=\"29\" xlink:href=\"#MJX-TEX-N-29\"></use></g></g><g data-mml-node=\"TeXAtom\" transform=\"translate(882,-138.9) scale(0.707)\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"1D452\" xlink:href=\"#MJX-TEX-I-1D452\"></use></g><g data-mml-node=\"mi\" transform=\"translate(466,0)\"><use data-c=\"1D45E\" xlink:href=\"#MJX-TEX-I-1D45E\"></use></g></g></g><g data-mml-node=\"mo\" transform=\"translate(1927.7,0)\"><use data-c=\"2E\" xlink:href=\"#MJX-TEX-N-2E\"></use></g></g></g></svg></mjx-container></p></p>\n\n<p>When we add them,</p>\n<p><mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -3.585ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"87.642ex\" height=\"5.205ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -716 38738 2300.8\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"munder\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"OP\" transform=\"translate(1187.3,0)\"><g data-mml-node=\"mstyle\"><g data-mml-node=\"munder\"><g data-mml-node=\"mi\" transform=\"translate(559,0)\"><use data-c=\"1D434\" xlink:href=\"#MJX-TEX-I-1D434\"></use></g><g data-mml-node=\"mo\" transform=\"translate(0,-438)\"><use data-c=\"23DF\" xlink:href=\"#MJX-TEX-N-23DF\"></use></g></g></g></g><g data-mml-node=\"TeXAtom\" transform=\"translate(0,-1343.3) scale(0.707)\" data-mjx-texcla