EX-N-30\"></use></g></g></g></g><g data-mml-node=\"mi\" transform=\"translate(324.8,-345) scale(0.707)\"><use data-c=\"1D44D\" xlink:href=\"#MJX-TEX-I-1D44D\"></use></g><rect width=\"920.9\" height=\"60\" x=\"120\" y=\"220\"></rect></g></g></g></g></svg></mjx-container></p>\n<p>When <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.025ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"1.407ex\" height=\"1.027ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -443 622 454\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"mi\"><use data-c=\"1D714\" xlink:href=\"#MJX-TEX-I-1D714\"></use></g></g></g></svg></mjx-container> is increased, the impedance of the circuit decreases and the current through the bulb increases. Therefore the bulb glows brighter.</p>"}]}