      "content": "The degenerate orbitals of [Cr(H<sub>2</sub>O)<sub>6</sub>]<sup>3+</sup> are :",
      "options": [
        {
          "identifier": "A",
          "content": "d<sub>x<sup>2</sup></sub> and d<sub>xz</sub>"
