://www.w3.org/2000/svg\" width=\"0.988ex\" height=\"1.099ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -320.2 436.6 485.8\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"msub\"><g data-mml-node=\"mi\"></g><g data-mml-node=\"mn\" transform=\"translate(33,-150) scale(0.707)\"><use data-c=\"33\" xlink:href=\"#MJX-TEX-N-33\"></use></g></g></g></g></svg></mjx-container>)<mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.339ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"0.988ex\" height=\"1.083ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -328.7 436.6 478.7\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"msub\"><g data-mml-node=\"mi\"></g><g data-mml-node=\"mn\" transform=\"translate(33,-150) scale(0.707)\"><use data-c=\"34\" xlink:href=\"#MJX-TEX-N-34\"></use></g></g></g></g></svg></mjx-container>Cl<mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.339ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"0.988ex\" height=\"1.065ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -320.9 436.6 470.9\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"msub\"><g data-mml-node=\"mi\"></g><g data-mml-node=\"mn\" transform=\"translate(33,-150) scale(0.707)\"><use data-c=\"32\" xlink:href=\"#MJX-TEX-N-32\"></use></g></g></g></g></svg></mjx-container>] possess axis of symmetry.</p>","options":[{"identifier":"A","content":"Statement 1 is True, Statement 2 is True; Statement 2 is a CORRECT explanation for Statement 1."},{"identifier":"B","content":"Statement 1 is True, Statement 2 is True; Statement 2 is a NOT CORRECT explanation for Statement 1."},{"identifier":"C","content":"Statement 1 is True, Statement 2 is False."},{"identifier":"D","content":"Statement 1 is False, Statement 2 is True."}],"correct_options":["B"],"answer":null,"explanation":"<p>For a complex to be optically active, it should not possess either centre of symmetry or axis of symmetry or plane of symmetry. Here, the given complex is an octahedral complex that possesses plane of symmetry as well as axis of symmetry and thus is optically inactive.</p>\n<p>The <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.025ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"2.821ex\" height=\"1.52ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -661 1247 672\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"mi\"><use data-c=\"1D450\" xlink:href=\"#MJX-TEX-I-1D450\"></use></g><g data-mml-node=\"mi\" transform=\"translate(433,0)\"><use data-c=\"1D456\" xlink:href=\"#MJX-TEX-I-1D456\"></use></g><g data-mml-node=\"mi\" transform=\"translate(778,0)\"><use data-c=\"1D460\" xlink:href=\"#MJX-TEX-I-1D460\"></use></g></g></g></svg></mjx-container> and <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.025ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"5.452ex\" height=\"1.441ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -626 2410 637\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"mi\"><use data-c=\"1D461\" xlink:href=\"#MJX-TEX-I-1D461\"></use></g><g data-mml-node=\"mi\" transform=\"translate(361,0)\"><use data-c=\"1D45F\" xlink:href=\"#MJX-TEX-I-1D45F\"></use></g><g data-mml-node=\"mi\" transform=\"translate(812,0)\"><use data-c=\"1D44E\" xlink:href=\"#MJX-TEX-I-1D44E\"></use></g><g data-mml-node=\"mi\" transform=\"translate(1341,0)\"><use data-c=\"1D45B\" xlink:href=\"#MJX-TEX-I-1D45B\"></use></g><g data-mml-node=\"mi\" transform=\"translate(1941,0)\"><use data-c=\"1D460\" xlink:href=\"#MJX-TEX-I-1D460\"></use></g></g></g></svg></mjx-container> both form of complex [M(NH<mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.375ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"0.988ex\" height=\"1.099ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -320.2 436.6 485.8\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"msub\"><g data-mml-node=\"mi\"></g><g data-mml-node=\"mn\" transform=\"translate(33,-150) scale(0.707)\"><use data-c=\"33\" xlink:href=\"#MJX-TEX-N-33\"></use></g></g></g></g></svg></mjx-container>)<mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.339ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"0.988ex\" height=\"1.083ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -328.7 436.6 478.7\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"msub\"><g data-mml-node=\"mi\"></g><g data-mml-node=\"mn\" transform=\"translate(33,-150) scale(0.707)\"><use data-c=\"34\" xlink:href=\"#MJX-TEX-N-34\"></use></g></g></g></g></svg></mjx-container>Cl<mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.339ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"0.988ex\" height=\"1.065ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -320.9 436.6 470.9\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"msub\"><g data-mml-node=\"mi\"></g><g data-mml-node=\"mn\" transform=\"translate(33,-150) scale(0.707)\"><use data-c=\"32\" xlink:href=\"#MJX-TEX-N-32\"></use></g></g></g></g></svg></mjx-container>] are optically inactive.</p>\n<p><img src=\"https://app-content.cdn.examgoal.net/fly/1000/image/1lgewql96/c590dee3-c5bb-48bc-8eb7-40676bd62c3e/14b397a0-d9dc-11ed-af1f-bf7b0ee7d77a/file-1lgewql97.png?format=png\" data-orsrc=\"https://app-content.cdn.examgoal.net/image/1lgewql96/c590dee3-c5bb-48bc-8eb7-40676bd62c3e/14b397a0-d9dc-11ed-af1f-bf7b0ee7d77a/file-1lgewql97.png\" loading=\"lazy\" style=\"max-width:100%;height:auto;display:block;margin:0px auto;max-height:40vh\" alt=\"IIT-JEE 2008 Paper 2 Offline Chemistry - Coordination Compounds Question 23 English Explanation\" srcset=\"https://app-content.cdn.examgoal.net/fly/500/image/1lgewql96/c590dee3-c5bb-48bc-8eb7-40676bd62c3e/14b397a0-d9dc-11ed-af1f-bf7b0ee7d77a/file-1lgewql97.png?format=png 500w, https://app-content.cdn.examgoal.net/fly/750/image/1lgewql96/c590dee3-c5bb-48bc-8eb7-40676bd62c3e/14b397a0-d9dc-11ed-af1f-bf7b0ee7d77a/file-1lgewql97.png?format=png 750w, https://app-content.cdn.examgoal.net/fly/1000/image/1lgewql96/c590dee3-c5bb-48bc-8eb7-40676bd62c3e/14b397a0-d9dc-11ed-af1f-bf7b0ee7d77a/file-1lgewql97.png?format=png 1000w, https://app-content.cdn.examgoal.net/fly/1500/image/1lgewql96/c590dee3-c5bb-48bc-8eb7-40676bd62c3e/14b397a0-d9dc-11ed-af1f-bf7b0ee7d77a/file-1lgewql97.png?format=png 1500w, https://app-content.cdn.examgoal.net/fly/2000/image/1lgewql96/c590dee3-c5bb-48bc-8eb7-40676bd62c3e/14b397a0-d9dc-11ed-af1f-bf7b0ee7d77a/file-1lgewql97.png?format=png 2000w, https://app-content.cdn.examgoal.net/fly/2500/image/1lgewql96/c590dee3-c5bb-48bc-8eb7-40676bd62c3e/14b397a0-d9dc-11ed-af1f-bf7b0ee7d77a/file-1lgewql97.png?format=png 2500w\" sizes=\"(max-width: 767px) 100vw, 720px\" decoding=\"async\"></p>"}},"subject":"chemistry","subjectGroup":null,"timeAllotted":200000,"topic":"isomerism-in-coordination-compounds","type":"mcq","year":2008,"isOutOfSyllabus":false,"isBonus":false,"yearKey":"iit-jee-2008-paper-2-offline","active":true},{"question_id":"1lfz01uvk","chapter":"thermodynamics","chapterGroup":"physical-chemistry","country":"in","difficulty":"easy","exam":"jee-advanced","examGroup":"jee","languages":["en"],"marks":3,"negMarks":1,"paperId":"iit-jee-2008-paper-2-offline","paperTitle":"IIT-JEE 2008 Paper 2 Offline","permalink":"pstatement-1--there-is-a-natural-asymmetry-between-conver-jee-advanced-chemistry-some-basic-concepts-of-chemistry-2zbd8tfiyjizgewd","question":{"en":{"comprehension":null,"direction":null,"content":"<p>Statement 1 : There is a natural asymmetry between converting work to heat and converting heat to work.</p>\n<p>Statement 2 : No process is possible in which the sole result is the absorption of heat from a reservoir and its complete conversion into work.</p>","options":[{"identifier":"A","content":"Statement 1 is True, Statement 2 is True; Statement 2 is a CORRECT explanation for Statement 1."},{"identifier":"B","content":"Statement 1 is True, Statement 2 is True; Statement 2 is a NOT CORRECT explanation for Statement 1."},{"identifier":"C","content":"Statement 1 is True, Statement 2 is False."},{"identifier":"D","content":"Statement 1 is False, Statement 2 is True."}],"correct_options":["A"],"answer":null,"explanation":"<p>In reality, work can be converted to heat entirely but not vice versa. This is in accordance with second law of thermodynamics. So, no process is possible in practice where heat is entirely converted to work.</p>\n<p>Take for example the heat engine. It has to reject some heat to the sink and convert the remainder into work. Thus, entire heat supplied is not converted into work. On the other hand, in a refrigerator, work has to be supplied to transfer heat from a colder body to hotter surroundings-in this case, the entire work input is converted to heat.</p>\n<p>In practice, reversible isothermal processes are impossible because heat transfer always takes place across a finite temperature difference. This is an irreversibility. Thus, the entropy of the system will always increase if there is a heat transfer to the system. In that case, the amount of heat supplied to the system cannot entirely be converted to work (unlike reversible isothermal processes where heat is entirely converted to work).</p>\n<p>So, both the statements are clearly true but the second one does not explain the first one.</p>"}},"subject":"chemistry","subjectGroup":null,"timeAllotted":200000,"topic":"second-law-of-thermodynamics","type":"mcq","year":2008,"isOutOfSyllabus":false,"isBonus":false,"yearKey":"iit-jee-2008-paper-2-offline","active":true},{"question_id":"1lfz04xgy","chapter":"alcohols-phenols-and-ethers","chapterGroup":"organic-chemistry","country":"in","difficulty":"hard","exam":"jee-advanced","examGroup":"jee","languages":["en"],"marks":3,"negMarks":1,"paperId":"iit-jee-2008-paper-2-offline","paperTitle":"IIT-JEE 2008 Paper 2 Offline","permalink":"pcompound-h-is-formed-by-the-reaction-ofp-jee-advanced-chemistry-some-basic-concepts-of-chemistry-wrv74xerfzxsm2om","question":{"en":{"comprehension":"<p>A tertiary alcohol H upon acid catalysed dehydration gives a product I. Ozonolysis of I leads to compounds J and K compound J upon reaction with KOH gives benzyl alcohol and a compound L, whereas K on reaction with KOH gives only M.</p>\n<p><img src=\"https://app-content.cdn.examgoal.net/fly/1000/image/1lgewve3n/908bb135-d570-4e26-959e-552a8b472b89/9a38a730-d9dc-11ed-af1f-bf7b0ee7d77a/file-1lgewve3o.png?format=png\" data-orsrc=\"https://app-content.cdn.examgoal.net/image/1lgewve3n/908bb135-d570-4e26-959e-552a8b472b89/9a38a730-d9dc-11ed-af1f-bf7b0ee7d77a/file-1lgewve3o.png\" loading=\"lazy\" style=\"max-width:100%;height:auto;display:block;margin:0px auto;max-height:40vh\" alt=\"IIT-JEE 2008 Paper 2 Offline Chemistry - Alcohols, Phenols and Ethers Question 16 English