"853\" y=\"846\"></rect></g></g></g></svg></mjx-container>\n\n<br><br>Therefore, \n\n<br><br><mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.781ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"8.953ex\" height=\"3.101ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -1025.7 3957.3 1370.7\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"mi\"><use data-c=\"1D437\" xlink:href=\"#MJX-TEX-I-1D437\"></use></g><g data-mml-node=\"mo\" transform=\"translate(1105.8,0)\"><use data-c=\"221D\" xlink:href=\"#MJX-TEX-N-221D\"></use></g><g data-mml-node=\"mfrac\" transform=\"translate(2161.6,0)\"><g data-mml-node=\"msup\" transform=\"translate(220,394) scale(0.707)\"><g data-mml-node=\"mi\"><use data-c=\"1D447\" xlink:href=\"#MJX-TEX-I-1D447\"></use></g><g data-mml-node=\"TeXAtom\" transform=\"translate(806.7,363) scale(0.707)\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mn\"><use data-c=\"33\" xlink:href=\"#MJX-TEX-N-33\"></use></g><g data-mml-node=\"mo\" transform=\"translate(500,0)\"><use data-c=\"2F\" xlink:href=\"#MJX-TEX-N-2F\"></use></g><g data-mml-node=\"mn\" transform=\"translate(1000,0)\"><use data-c=\"32\" xlink:href=\"#MJX-TEX-N-32\"></use></g></g></g><g data-mml-node=\"mi\" transform=\"translate(632.4,-345) scale(0.707)\"><use data-c=\"1D443\" xlink:href=\"#MJX-TEX-I-1D443\"></use></g><rect width=\"1555.7\" height=\"60\" x=\"120\" y=\"220\"></rect></g></g></g></svg></mjx-container>\n\n<br><br>The change in the diffusion coefficient would then be given by :\n\n<br><br><mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -1.469ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"20.768ex\" height=\"4.652ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -1406.9 9179.7 2056.4\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentCol