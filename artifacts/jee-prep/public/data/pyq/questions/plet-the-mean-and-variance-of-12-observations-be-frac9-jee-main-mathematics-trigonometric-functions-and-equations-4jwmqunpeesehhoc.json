=\"1ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -442 833 442\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"6D\" xlink:href=\"#MJX-TEX-N-6D\"></use></g></g></g></g></svg></mjx-container> and <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: 0;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"1.258ex\" height=\"1ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -442 556 442\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"6E\" xlink:href=\"#MJX-TEX-N-6E\"></use></g></g></g></g></svg></mjx-container> are coprime, then <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.186ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"5.908ex\" height=\"1.505ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -583 2611.4 665\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"6D\" xlink:href=\"#MJX-TEX-N-6D\"></use></g></g><g data-mml-node=\"mo\" transform=\"translate(1055.2,0)\"><use data-c=\"2B\" xlink:href=\"#MJX-TEX-N-2B\"></use></g><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\" transform=\"translate(2055.4,0)\"><g data-mml-node=\"mi\"><use data-c=\"6E\" xlink:href=\"#MJX-TEX-N-6E\"></use></g></g></g></g></svg></mjx-container> is equal to :</p>",
